#!/usr/bin/env bash
# Worker wrapper: runs `claude` against a dedicated Anthropic API key with an
# identity fully isolated from any subscription login in the parent environment.
#
# Key resolution order (each source cascades to the next on failure/empty):
#   1. $CLAUDE_API_KEY_CMD        (a command that prints the key, e.g. a vault CLI)
#   2. macOS Keychain             (service $CLAUDE_API_KEYCHAIN_SERVICE, default claude-api-worker)
#   3. $CLAUDE_API_CONFIG_DIR/api-key   (0600 file — the path for Linux/clusters)
# Store the key with bin/store-key (works on both platforms).
#
# Permission mode resolution (first match wins):
#   1. Explicit --permission-mode / --dangerously-skip-permissions in the args
#   2. Inherited from the parent Claude Code session when it runs in an elevated
#      mode (bypassPermissions / dontAsk / auto) — recorded per Bash call by
#      bin/permission-mode-hook (registered in ~/.claude/settings.json by setup-worker)
#   3. Floor default: acceptEdits
#
# Framework subcommands (handled here, not passed to claude):
#   claude-api run <slug> "<task>" [--stay] [flags] → spawn a worker (steerable; one-shot by default)
#   claude-api ps | kill | clean | send | reply | end → bin/worker-ctl (worker lifecycle + messaging)
#   claude-api ask | questions | answer → bin/worker-ctl (worker→human Q&A relay)
#   claude-api doctor [--ping]        → bin/doctor       (install health check)
#   claude-api selftest               → bin/selftest     (validation matrix; spends credits)
#   claude-api worktree add|list|clean → bin/worker-worktree (parallel-worker isolation)
# Every real run is appended to $CONFIG_DIR/run/ledger.jsonl (see claude-api ps).
set -euo pipefail

# Resolve our own location through symlinks (~/.local/bin/claude-api → repo/bin).
SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do
  dir="$(cd "$(dirname "$SRC")" && pwd)"
  SRC="$(readlink "$SRC")"
  case "$SRC" in /*) ;; *) SRC="$dir/$SRC" ;; esac
done
BIN_DIR="$(cd "$(dirname "$SRC")" && pwd)"

CONFIG_DIR="${CLAUDE_API_CONFIG_DIR:-$HOME/.claude-api}"
KEYCHAIN_SERVICE="${CLAUDE_API_KEYCHAIN_SERVICE:-claude-api-worker}"
RUN_DIR="$CONFIG_DIR/run"
export CLAUDE_CONFIG_DIR="$CONFIG_DIR"

# Framework subcommands.
case "${1:-}" in
  ps|kill|clean|send|reply|end|ask|questions|answer) exec "$BIN_DIR/worker-ctl" "$@" ;;
  doctor)        shift; exec "$BIN_DIR/doctor" "$@" ;;
  selftest)      shift; exec "$BIN_DIR/selftest" "$@" ;;
  worktree)      shift; exec "$BIN_DIR/worker-worktree" "$@" ;;
  run)
    # Worker spawn with Agent-tool ergonomics: a single (background) Bash call;
    # stdout of the finished command IS the worker's answer, so the harness
    # completion notification delivers it. The worker runs stream-json over a
    # FIFO that this process creates, holds open, and supervises — so the same
    # worker is steerable mid-run with `claude-api send` and stays one-shot in
    # behavior when nothing is sent (one turn, then run closes the pipe and
    # postprocesses). --stay disables the auto-close: the worker idles between
    # messages until `claude-api end <slug>` (TERMs this pid, recorded in
    # <slug>.keeper) or worker death. Close protocol against send (silent-loss
    # race): flock on <slug>.lock + result-vs-sent accounting + unlink-before-
    # close; see bin/worker-ctl send for the other half.
    shift
    slug="${1:?usage: claude-api run <slug> \"<task>\" [--stay] [extra claude flags]}"; shift
    prompt="${1:?usage: claude-api run <slug> \"<task>\" [--stay] [extra claude flags]}"; shift || true
    case "$slug" in
      *[!A-Za-z0-9._-]*) echo "claude-api run: slug must match [A-Za-z0-9._-]" >&2; exit 2 ;;
    esac
    if [ "$PWD" -ef "$HOME" ]; then
      echo "claude-api run: refusing to spawn from \$HOME (the worker sandbox would cover your whole home dir) — cd into the target repo or a scratch dir" >&2
      exit 2
    fi
    stay=0; allow_dirty=0; rest=()
    for a in "$@"; do
      case "$a" in
        --stay) stay=1 ;;
        --allow-dirty) allow_dirty=1 ;;
        *) rest+=("$a") ;;
      esac
    done
    # Dirty-tree guard: a worker spawned into a repo with uncommitted changes
    # can collide with another session's in-flight work. Refuse and point at
    # the worktree helper; --allow-dirty overrides (e.g. the changes are the
    # worker's own input).
    if [ "$allow_dirty" -eq 0 ] && command -v git >/dev/null 2>&1 \
       && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      dirty="$(git status --porcelain 2>/dev/null || true)"
      if [ -n "$dirty" ]; then
        {
          echo "claude-api run: refusing to spawn — $(git rev-parse --show-toplevel) has uncommitted changes (another session may be working here):"
          printf '%s\n' "$dirty" | head -5 | sed 's/^/  /'
          n=$(printf '%s\n' "$dirty" | wc -l)
          [ "$n" -gt 5 ] && echo "  ... and $((n - 5)) more"
          echo "either spawn in an isolated worktree:"
          echo "  WT=\$(claude-api worktree add $slug) && cd \"\$WT\" && claude-api run $slug \"<task>\""
          echo "or pass --allow-dirty to run in this tree anyway."
        } >&2
        exit 2
      fi
    fi
    WDIR="$CONFIG_DIR/run/workers/${CLAUDE_CODE_SESSION_ID:-manual}"
    mkdir -p "$WDIR"
    if [ -e "$WDIR/$slug.ndjson" ] || [ -e "$WDIR/$slug.json" ]; then
      echo "claude-api run: note — slug '$slug' was used before in this session; overwriting its artifacts (concurrent same-slug runs would corrupt each other)" >&2
    fi
    export CLAUDE_API_RUN_SLUG="$slug"
    CLAUDE_API_RUN_TASK="$prompt" exec python3 - "$SRC" "$WDIR" "$slug" "$CONFIG_DIR" "$stay" ${rest[@]+"${rest[@]}"} <<'PYEOF'
import array, errno, fcntl, json, os, signal, stat, subprocess, sys, termios, time

src, wdir, slug, cfg = sys.argv[1:5]
stay = sys.argv[5] == "1"
extra = sys.argv[6:]
task = os.environ.pop("CLAUDE_API_RUN_TASK")

base = os.path.join(wdir, slug)
fifo, nd, errf = base + ".in", base + ".ndjson", base + ".err"
lockp, sentp, keeperp, statep = base + ".lock", base + ".sent", base + ".keeper", base + ".state"

for s in (sys.stdout, sys.stderr):
    s.reconfigure(errors="replace")
def note(msg):
    print("worker %s: %s" % (slug, msg), file=sys.stderr, flush=True)

# Exclusive FIFO creation. EEXIST → probe: a writable-open succeeding means a
# live worker reads it (abort — force-creating would cross-wire two runs);
# ENXIO means a stale leftover from a dead run (safe to replace).
try:
    os.mkfifo(fifo)
except FileExistsError:
    if not stat.S_ISFIFO(os.stat(fifo).st_mode):
        sys.exit("claude-api run: %s exists and is not a FIFO — refusing to touch it" % fifo)
    try:
        pfd = os.open(fifo, os.O_WRONLY | os.O_NONBLOCK)
    except OSError as e:
        if e.errno != errno.ENXIO:
            sys.exit("claude-api run: cannot probe existing %s: %s" % (fifo, e))
        os.unlink(fifo)
        os.mkfifo(fifo)
    else:
        os.close(pfd)
        sys.exit("claude-api run: slug '%s' already has a LIVE worker on %s — pick another slug, or end that worker first (claude-api end %s)" % (slug, fifo, slug))

# Open order matters: the nonblocking read probe first (never blocks), then the
# write end (succeeds because the probe is a reader), then the worker's blocking
# read open (succeeds because the write end exists). The probe fd is only ever
# read at the final drain; send's liveness comes from the lock+unlink protocol,
# not from ENXIO, so holding it persistently is safe — as long as every exit
# path below unlinks the FIFO promptly.
probe_rfd = os.open(fifo, os.O_RDONLY | os.O_NONBLOCK)
wfd = os.open(fifo, os.O_WRONLY)
fcntl.fcntl(wfd, fcntl.F_SETFL, os.O_NONBLOCK)
lock_fd = os.open(lockp, os.O_RDWR | os.O_CREAT, 0o600)

# .keeper = the pid whose TERM ends the worker gracefully. That is us now:
# kill/clean/end all compose through it.
with open(keeperp, "w") as f:
    f.write("%d\n" % os.getpid())
open(sentp, "w").close()  # send appends one line per delivered message

cur_state = None
def set_state(st):
    global cur_state
    if st == cur_state:
        return
    cur_state = st
    tmp = statep + ".tmp"
    try:
        with open(tmp, "w") as f:
            f.write("%s %d\n" % (st, int(time.time())))
        os.replace(tmp, statep)
    except OSError:
        pass

def sent_count():
    try:
        with open(sentp, "rb") as f:
            return sum(1 for _ in f)
    except OSError:
        return 0

def fionread():
    buf = array.array("i", [0])
    fcntl.ioctl(probe_rfd, termios.FIONREAD, buf)
    return buf[0]

def lock(timeout=180):
    deadline = time.time() + timeout
    while True:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return True
        except OSError:
            if time.time() > deadline:
                return False
            time.sleep(0.1)

# Turn accounting from complete (newline-terminated) top-level ndjson lines.
offset, results, last_top = 0, 0, None
def scan_new():
    global offset, results, last_top
    try:
        with open(nd, "rb") as f:
            f.seek(offset)
            data = f.read()
    except OSError:
        return
    cut = data.rfind(b"\n")
    if cut < 0:
        return
    offset += cut + 1
    for line in data[:cut + 1].splitlines():
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if not isinstance(e, dict) or e.get("parent_tool_use_id") or not e.get("type"):
            continue
        last_top = e["type"]
        if last_top == "result":
            results += 1
    if last_top:
        set_state("idle" if last_top == "result" else "busy")

fifo_gone = pipe_closed = False
def close_pipe(force=False):
    """Locked close handoff. Normal path: close only when every message has its
    result line AND the pipe is empty. unlink FIRST so a racing send fails with
    ENOENT instead of writing into a pipe nobody will read; then drain the probe
    fd and report anything found (must be empty on the normal path)."""
    global fifo_gone, pipe_closed
    if pipe_closed:
        return True
    got = lock()
    if not got:
        note("WARNING: could not take %s within 180s — closing without the lock (a concurrent send may be lost; check its exit status)" % lockp)
    try:
        if not force:
            scan_new()
            if results < 1 + sent_count() or fionread() != 0:
                return False
        else:
            missing = 1 + sent_count() - results
            if missing > 0 and not stay:
                note("WARNING: %d sent message(s) unaccounted at close (no result line for them)" % missing)
        try:
            os.unlink(fifo)
        except OSError:
            pass
        fifo_gone = True
        try:
            os.close(wfd)
        except OSError:
            pass
        left = b""
        while True:
            try:
                c = os.read(probe_rfd, 65536)
            except OSError:
                break
            if not c:
                break
            left += c
        try:
            os.close(probe_rfd)
        except OSError:
            pass
        pipe_closed = True
        if left:
            note("WARNING: %d bytes of sent message(s) were queued in the pipe and never read by the worker:\n%s"
                 % (len(left), left.decode("utf-8", "replace")[:2000]))
        return True
    finally:
        if got:
            fcntl.flock(lock_fd, fcntl.LOCK_UN)

shutdown = False
def _term(signum, frame):
    global shutdown
    shutdown = True
signal.signal(signal.SIGTERM, _term)
signal.signal(signal.SIGINT, _term)

rc = 1
linger_killed = False

def wait_after_close():
    """Wait for the worker to exit after a committed close. A native peer
    message (SendMessage) arriving around the close can start a post-EOF turn,
    after which the CLI never exits (verified on 2.1.224). The wedge signature
    is idle-with-EOF: stdin closed, last top-level event a per-turn result, yet
    the process stays alive producing nothing — TERM it once it has been idle
    AND silent for CLAUDE_API_CLOSE_GRACE seconds (default 120; 0 disables).
    Keying on idleness makes the guard safe on every close path: after
    `claude-api end`, a worker finishing a long silent tool call has a
    non-result last event and is never touched."""
    global linger_killed
    try:
        grace = float(os.environ.get("CLAUDE_API_CLOSE_GRACE", "120"))
    except ValueError:
        grace = 120.0
    if grace <= 0:
        return child.wait()
    def nd_size():
        try:
            return os.path.getsize(nd)
        except OSError:
            return -1
    last_size, quiet_since = nd_size(), time.time()
    while True:
        try:
            return child.wait(timeout=1)
        except subprocess.TimeoutExpired:
            pass
        size = nd_size()
        if size != last_size:
            last_size, quiet_since = size, time.time()
            continue
        scan_new()
        if last_top == "result" and time.time() - quiet_since > grace:
            note("WARNING: worker still alive and idle %ds after close "
                 "(a native SendMessage racing the close can wedge the CLI) — terminating it"
                 % int(grace))
            linger_killed = True
            child.terminate()
            try:
                return child.wait(timeout=10)
            except subprocess.TimeoutExpired:
                child.kill()
                return child.wait()

try:
    set_state("busy")
    # Spawn first, then write the task: the worker's stdout goes DIRECTLY to
    # the ndjson (ps busy/idle readlinks its fd/1 — no interposed pipe).
    rfd_child = os.open(fifo, os.O_RDONLY)
    nd_fd = os.open(nd, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    err_fd = os.open(errf, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    child = subprocess.Popen(
        [src, "-p", "--input-format", "stream-json", "--output-format", "stream-json", "--verbose"] + extra,
        stdin=rfd_child, stdout=nd_fd, stderr=err_fd)
    for fd in (rfd_child, nd_fd, err_fd):
        os.close(fd)

    # Initial task: nonblocking write loop with a child-alive check — a worker
    # that crashes at startup must not wedge us in a blocking write. (No EPIPE
    # can fire while probe_rfd is open, so poll() is the only death signal.)
    payload = (json.dumps({"type": "user", "message": {"role": "user", "content": task}}) + "\n").encode()
    # Serialized with send via the shared lock: a task larger than the free
    # pipe capacity (64KB) takes multiple writes, and an early send landing
    # between them would splice its message into the middle of the task line.
    done = 0
    fcntl.flock(lock_fd, fcntl.LOCK_EX)
    try:
        while done < len(payload) and not shutdown:
            try:
                done += os.write(wfd, payload[done:])
            except BlockingIOError:
                if child.poll() is not None:
                    break
                time.sleep(0.05)
    finally:
        fcntl.flock(lock_fd, fcntl.LOCK_UN)

    # Supervision: poll the ndjson for complete lines (tail --pid -F semantics,
    # portable) — worker death MUST end this loop; there is deliberately no
    # inactivity timeout (an `ask` legitimately stalls a turn for many minutes).
    committed = False
    hedge_since = None
    while True:
        scan_new()
        child_rc = child.poll()
        if shutdown and not committed:
            committed = close_pipe(force=True)  # graceful end: EOF, worker finishes its turn
        if not committed and not stay and not shutdown and last_top == "result" and results >= 1:
            committed = close_pipe()
        if committed:
            rc = wait_after_close()
            break
        if child_rc is not None:
            # Worker died without a committed close — make sends fail fast and
            # report anything stranded in the pipe.
            close_pipe(force=True)
            rc = child_rc
            break
        # Hedge: idle, pipe empty, but accounting short (a message folded into
        # an earlier turn, or a result line never came) — after 120s close
        # anyway; close_pipe(force) prints the loud unaccounted footer.
        if (not stay and not shutdown and last_top == "result" and results >= 1
                and fionread() == 0 and results < 1 + sent_count()):
            if hedge_since is None:
                hedge_since = time.time()
            elif time.time() - hedge_since > 120:
                committed = close_pipe(force=True)
                continue
        else:
            hedge_since = None
        time.sleep(0.5)
finally:
    if not pipe_closed:
        close_pipe(force=True)  # crash path of run itself: unlink promptly, drain, report
    for p in (keeperp, statep, sentp, lockp):
        try:
            os.unlink(p)
        except OSError:
            pass

# Postprocess: re-read the ndjson AFTER worker exit (a raced-in message may
# have produced one more turn than the line that triggered the close).
last_result, sid, n_results = None, None, 0
try:
    with open(nd, "rb") as f:
        for line in f:
            try:
                e = json.loads(line)
            except ValueError:
                continue
            if not isinstance(e, dict) or e.get("parent_tool_use_id"):
                continue
            if sid is None and isinstance(e.get("session_id"), str):
                sid = e["session_id"]
            if e.get("type") == "result":
                last_result, n_results = e, n_results + 1
except OSError:
    pass
if last_result is not None and isinstance(last_result.get("session_id"), str):
    sid = last_result["session_id"]
sid = sid or "?"

subtype = "no-result-line" if last_result is None else (last_result.get("subtype") or "?")
cost = last_result.get("total_cost_usd") if last_result is not None else None
coststr = "$%.2f" % cost if isinstance(cost, (int, float)) else "?"
result_text = last_result.get("result") if last_result is not None else None

# An empty result with subtype "success" is never a real success: the CLI
# ended the run without the model producing a final answer. Seen when the
# worker parks itself (ScheduleWakeup / waiting on background tasks — headless
# workers get no wakeups; stop_reason "tool_use") or a limit stops the run.
# linger_killed: we TERM'd a worker that had already delivered its result but
# would not exit (post-close peer-message wedge) — its nonzero rc is ours, not
# a worker failure.
ok = ((rc == 0 or linger_killed) and last_result is not None
      and not last_result.get("is_error")
      and last_result.get("subtype") == "success" and bool(result_text))

cause = None
stl = subtype.lower()
stop_reason = last_result.get("stop_reason") if last_result is not None else None
if "budget" in stl or "max_cost" in stl or "cost_limit" in stl:
    cause = "BUDGET CAP HIT — --max-budget-usd / CLAUDE_API_MAX_BUDGET_USD ended the run at %s" % coststr
elif "max_turn" in stl:
    cause = "TURN LIMIT HIT (--max-turns)"
elif not ok and subtype == "success" and not result_text:
    if stop_reason == "tool_use":
        cause = ("WORKER PARKED ITSELF (stop_reason tool_use) — it ended its turn on "
                 "ScheduleWakeup or an unfinished background task; headless workers are "
                 "never re-invoked. Respin with: do the work in this turn, no wakeups.")
    else:
        cause = ("EMPTY RESULT despite subtype success — possibly a limit stop "
                 "(--max-budget-usd/CLAUDE_API_MAX_BUDGET_USD or --max-turns); cost was %s" % coststr)

try:
    with open(os.path.join(cfg, "cost-log.jsonl"), "a", encoding="utf-8") as f:
        entry = {"ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                 "task": slug, "cost": cost, "session": sid}
        if not ok:
            # Three distinct failure shapes; conflating them corrupts the
            # diagnostic record the README troubleshooting section points at.
            if subtype != "success":
                entry["failed"] = subtype
            elif not result_text:
                entry["failed"] = "empty-result"
            else:
                # A successful turn happened but the run still failed — the
                # worker was killed or died after its last result line.
                entry["failed"] = "exit-%s" % rc
        f.write(json.dumps(entry) + "\n")
except OSError:
    pass

if ok:
    print(result_text)
    print('[worker %s: %s · %d turn(s) · resume: claude-api --resume %s -p "<follow-up>" --output-format json · ndjson: %s]'
          % (slug, coststr, n_results, sid, nd), file=sys.stderr)
    sys.exit(0)
print("worker %s FAILED (exit %s, subtype: %s, cost: %s, %d turn(s), session: %s) — respin with a sharper prompt or resume; see %s"
      % (slug, rc, subtype, coststr, n_results, sid, nd), file=sys.stderr)
if cause:
    print("cause: %s" % cause, file=sys.stderr)
if result_text:
    print("partial result:\n%s" % result_text, file=sys.stderr)
try:
    with open(errf, encoding="utf-8", errors="replace") as f:
        tail = f.read()[-2000:]
    if tail.strip():
        print("stderr tail:\n%s" % tail, file=sys.stderr)
except OSError:
    pass
sys.exit(1)
PYEOF
    ;;
esac

# Meta calls pass through without mode injection, ledger, or a hard key requirement.
meta=0
case "${1:-}" in
  mcp|config|update|install|setup-token|auth|plugin|migrate-installer|agents|-h|--help|-v|--version) meta=1 ;;
esac

# Key resolution — independent cascading sources.
key=""
if [ -n "${CLAUDE_API_KEY_CMD:-}" ]; then
  key="$(eval "$CLAUDE_API_KEY_CMD" 2>/dev/null || true)"
  [ -n "$key" ] || echo "claude-api: CLAUDE_API_KEY_CMD produced no key; trying next source" >&2
fi
if [ -z "$key" ] && [ "$(uname)" = Darwin ] && command -v security >/dev/null 2>&1; then
  key="$(security find-generic-password -s "$KEYCHAIN_SERVICE" -w 2>/dev/null || true)"
fi
if [ -z "$key" ] && [ -f "$CONFIG_DIR/api-key" ]; then
  key="$(tr -d '[:space:]' < "$CONFIG_DIR/api-key")"
fi

if [ -n "$key" ]; then
  export ANTHROPIC_API_KEY="$key"
elif [ "$meta" -eq 0 ]; then
  echo "claude-api: no API key found." >&2
  echo "Store it once with:  claude-api-store-key  (or $BIN_DIR/store-key)" >&2
  echo "(macOS: Keychain service '$KEYCHAIN_SERVICE'; Linux: $CONFIG_DIR/api-key, 0600)" >&2
  exit 1
fi

# Nothing inherited from the parent may win the auth precedence (AUTH_TOKEN
# outranks API_KEY), reroute traffic (BASE_URL, Bedrock/Vertex switches), or
# override the worker model.
unset ANTHROPIC_AUTH_TOKEN CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_BASE_URL \
      CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX \
      ANTHROPIC_MODEL ANTHROPIC_SMALL_FAST_MODEL ANTHROPIC_CUSTOM_HEADERS 2>/dev/null || true

if [ "$meta" -eq 1 ]; then
  exec claude "$@"
fi

# Give workers a route back to this session's question inbox (claude-api ask):
# inside a worker, CLAUDE_CODE_SESSION_ID is the worker's own session, so the
# parent's id must travel separately. Never overwrite an inherited value.
if [ -z "${CLAUDE_API_PARENT_SID:-}" ] && [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
  export CLAUDE_API_PARENT_SID="$CLAUDE_CODE_SESSION_ID"
fi

# Native discovery: name the worker session after its run slug so it shows up
# in ListAgents and is addressable with SendMessage (requires the shared
# sessions registry — see setup-worker). An explicit -n/--name wins.
if [ -n "${CLAUDE_API_RUN_SLUG:-}" ]; then
  has_name=0
  for a in "$@"; do
    case "$a" in
      -n|--name|--name=*) has_name=1 ;;
    esac
  done
  if [ "$has_name" -eq 0 ]; then
    set -- -n "$CLAUDE_API_RUN_SLUG" "$@"
  fi
fi

# Permission mode: explicit flag > inherited elevated parent mode > acceptEdits.
explicit=0
for a in "$@"; do
  case "$a" in
    --permission-mode|--permission-mode=*|--dangerously-skip-permissions) explicit=1 ;;
  esac
done
if [ "$explicit" -eq 0 ]; then
  mode=""
  if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
    mode_file="$RUN_DIR/permission-mode-${CLAUDE_CODE_SESSION_ID}"
    # Trust the file only if it's a regular, non-symlink file we own.
    if [ -f "$mode_file" ] && [ ! -L "$mode_file" ] && [ -O "$mode_file" ]; then
      mode="$(cat "$mode_file" 2>/dev/null || true)"
    fi
  fi
  case "$mode" in
    bypassPermissions|dontAsk|auto)
      echo "claude-api: inheriting permission mode '$mode' from parent session" >&2
      set -- --permission-mode "$mode" "$@" ;;
    *) set -- --permission-mode acceptEdits "$@" ;;
  esac
fi

# Default model: fable. Headless sessions ignore the `model` key in the
# worker settings.json (verified on Claude Code v2.1.222), so the default is
# pinned via the --settings flagSettings scope instead. An explicit --model
# wins; a caller-supplied --settings suppresses the injection.
has_settings=0 has_model=0
for a in "$@"; do
  case "$a" in
    --settings|--settings=*) has_settings=1 ;;
    --model|--model=*) has_model=1 ;;
  esac
done
if [ "$has_settings" -eq 0 ] && [ "$has_model" -eq 0 ]; then
  set -- --settings '{"model": "claude-fable-5"}' "$@"
fi

# Headless briefing: ScheduleWakeup never fires for a `claude -p` process, and
# a run closes once its messages are answered — a worker that parks itself on a
# wakeup or an unfinished background task dies with an empty result. Warn the
# model up front and hard-deny the tool. Applies to every headless spawn (the
# run path re-enters here with -p, --stay included; --resume ... -p too), never
# to interactive ones. A caller-supplied --append-system-prompt or
# --disallowedTools suppresses the matching injection (no merging).
headless=0 has_sysprompt=0 has_disallowed=0
for a in "$@"; do
  case "$a" in
    -p|--print) headless=1 ;;
    --append-system-prompt|--append-system-prompt=*) has_sysprompt=1 ;;
    --disallowedTools|--disallowedTools=*) has_disallowed=1 ;;
  esac
done
if [ "$headless" -eq 1 ]; then
  if [ "$has_disallowed" -eq 0 ]; then
    set -- --disallowedTools ScheduleWakeup "$@"
  fi
  if [ "$has_sysprompt" -eq 0 ]; then
    brief='You are a headless worker (claude -p). ScheduleWakeup never fires for you — never call it. Notifications from your own background Bash tasks and subagents reach you only while this run is alive; never end your turn with work pending on a wakeup or an unfinished background task. Finish the job within your turn; wait on external state with bounded foreground polls, in short chunks (~60 s per tool call, a loop of short sleeps rather than one long one) — messages sent to you mid-run surface at each tool-result boundary, so short calls keep you steerable. Your final message is the run result — end with the concrete answer or report.'
    # Tell the worker who spawned it, so it can notify the parent session
    # natively (SendMessage) — e.g. as a wake-up ping right before blocking in
    # `claude-api ask`. Best-effort: skipped when the parent has no registry
    # entry (session ended, old CLI version).
    if [ -n "${CLAUDE_API_PARENT_SID:-}" ] && command -v python3 >/dev/null 2>&1; then
      pname="$(python3 - "$HOME/.claude/sessions" "$CLAUDE_API_PARENT_SID" 2>/dev/null <<'PY' || true
import glob, json, sys
d, sid = sys.argv[1], sys.argv[2]
for f in glob.glob(d + "/*.json"):
    try:
        e = json.load(open(f))
    except Exception:
        continue
    if e.get("sessionId") == sid:
        print(e.get("name", ""))
        break
PY
)"
      if [ -n "$pname" ]; then
        brief="$brief The session that spawned you is the agent named '$pname'; you may notify it with your SendMessage tool (when SendMessage asks you to confirm with a ref, re-send using the exact ref it shows)."
      fi
    fi
    set -- --append-system-prompt "$brief" "$@"
  fi
fi

# No default spend cap: the key bills a flat pool, so a cap would only abort
# legitimately expensive runs. Opt in per spawn with --max-budget-usd, or set
# CLAUDE_API_MAX_BUDGET_USD to restore a default ceiling.
if [ -n "${CLAUDE_API_MAX_BUDGET_USD:-}" ]; then
  has_budget=0 has_print=0
  for a in "$@"; do
    case "$a" in
      --max-budget-usd|--max-budget-usd=*) has_budget=1 ;;
      -p|--print) has_print=1 ;;
    esac
  done
  if [ "$has_budget" -eq 0 ] && [ "$has_print" -eq 1 ]; then
    set -- --max-budget-usd "$CLAUDE_API_MAX_BUDGET_USD" "$@"
  fi
fi

# Run ledger (read by claude-api ps). Values sanitized to JSON-safe characters.
mkdir -p "$RUN_DIR" 2>/dev/null || true
chmod 700 "$RUN_DIR" 2>/dev/null || true
LEDGER="$RUN_DIR/ledger.jsonl"
san() { printf '%s' "$1" | tr -c 'A-Za-z0-9 ._/=:,+@-' '_' | cut -c1-200; }
start_ts="$(date +%s)"

# The slug env var existed only for this re-entry's -n injection and the
# ledger label below — un-export it so the worker's process tree doesn't
# inherit it (a nested claude-api call inside the worker would otherwise get
# the parent's name injected and register a duplicate agent).
export -n CLAUDE_API_RUN_SLUG 2>/dev/null || true

# `<&0` is load-bearing: bash redirects a background job's stdin to /dev/null
# when job control is off, which would starve FIFO/stream-json workers.
claude "$@" <&0 &
child=$!
trap 'kill -TERM "$child" 2>/dev/null || true' TERM INT
# run workers pass the task through the FIFO, not argv — the slug is the label.
printf '{"event":"spawn","ts":%s,"pid":%s,"sid":"%s","slug":"%s","cwd":"%s","cmd":"%s"}\n' \
  "$start_ts" "$child" "$(san "${CLAUDE_CODE_SESSION_ID:-}")" "$(san "${CLAUDE_API_RUN_SLUG:-}")" "$(san "$PWD")" "$(san "$*")" >> "$LEDGER" 2>/dev/null || true
rc=0
wait "$child" || rc=$?
printf '{"event":"exit","ts":%s,"pid":%s,"exit":%s,"secs":%s}\n' \
  "$(date +%s)" "$child" "$rc" "$(( $(date +%s) - start_ts ))" >> "$LEDGER" 2>/dev/null || true
exit "$rc"
