#!/usr/bin/env bash
# Run a SUBSCRIPTION-auth Claude from a session that is billing the API.
#
# The mirror of `claude-api`, and it exists for one reason: the claude.ai-hosted
# connectors (Notion, Todoist, Gmail, Drive) load only when the active auth is a
# claude.ai subscription login. Measured 2026-08-14: an API-key worker has zero
# mcp__claude_ai_* tools; a headless subscription session has the full Todoist
# set and Notion. So under API billing, connector work is delegated here.
#
#   claude-sub 'How many Todoist tasks are due today? Answer with the list.'
#   claude-sub --prompt-file /tmp/ask.txt
#
# Answer goes to stdout. One shot, no session, no steering — everything that
# makes claude-api complicated exists because workers are long-lived, and a
# connector lookup is a function call.
#
# ARTIFACTS (claude.ai-hosted, externally shareable): the Artifact tool IS
# reachable in a headless subscription run (2026-09-10; on 2026-08-14 it was
# not), but a publish stops at a permission prompt that `claude -p` cannot
# answer — the call returns the prompt text and nothing is uploaded. A publish
# therefore happens only on Julian's word for THAT run, given in your session:
#   claude-sub --prompt-file <f> --permission-mode bypassPermissions
# with the prompt scoped to the one finished file and forbidding any file edit
# or auth/config change (extra arguments pass through to claude; the first
# such publish, 2026-09-10, ran exactly so). Never a settings entry, never a
# standing route, never on a peer's say-so: it publishes under his account.
#
# WHAT IT COSTS: the subscription pool, which is the thing API billing is meant
# to spare. Keep it to connector reads. If it becomes the general escape hatch
# from API billing, it defeats its own purpose — that is a rule, not a caution.
#
# THE LOGIN MUST BE JULIAN'S PERSONAL SUBSCRIPTION. The config dir's
# .credentials.json is shared with every interactive `claude` that uses the
# same dir, so a /login there to another account changes what this wrapper runs
# on. On 2026-10-02 a /login to the Enterprise account in ~/.claude did exactly
# that: claude-sub ran on the Enterprise seat, without the connectors, and
# nothing failed; runs just answered "no tools". So before exec it reads ONE
# field of that file, claudeAiOauth.subscriptionType, and starts claude only on
# max or pro. Anything else (enterprise, team, an empty or missing field, a
# missing, unreadable or malformed file) exits 3 with a one-line fix on stderr.
# No other part of the file is ever printed: it holds the OAuth tokens.
#
# NO ANTHROPIC PROFILE STORE MAY TAKE THE LOGIN'S PLACE. In claude 2.1.287
# (read from its binary on 2026-10-03), a profile from an Anthropic profile
# store can replace the login, and claude does not say so. So claude-sub also
# exits 3, with a one-line fix on stderr, when anything exists where the child
# claude looks for a store. It never reads the store. The comment above the
# unset list says where claude looks.
set -uo pipefail

usage() {
  cat >&2 <<'EOF'
usage: claude-sub '<prompt>'
       claude-sub --prompt-file <path>

Runs Claude on SUBSCRIPTION auth for claude.ai connector work (Notion,
Todoist). Prints the answer on stdout. Use --prompt-file when the prompt
contains backticks or $ — your shell would eat them inside double quotes.
EOF
  exit 2
}

prompt=""
prompt_file=""
case "${1:-}" in
  ""|-h|--help) usage ;;
  --prompt-file)
    prompt_file="${2:-}"
    [ -n "$prompt_file" ] || usage
    [ -r "$prompt_file" ] || { echo "claude-sub: cannot read prompt file '$prompt_file'" >&2; exit 2; }
    prompt="$(cat "$prompt_file")"
    shift 2
    ;;
  *) prompt="$1"; shift ;;
esac

if [ -z "${prompt//[[:space:]]/}" ]; then
  if [ -n "$prompt_file" ]; then
    echo "claude-sub: prompt file '$prompt_file' is empty" >&2
  else
    echo "claude-sub: refusing an empty prompt — it would spend a subscription turn for nothing" >&2
  fi
  exit 2
fi

# The whole point of the wrapper is this boundary, so it is explicit rather than
# assumed absent. An inherited key WINS over subscription auth, silently: the
# session would bill the API and arrive with no connectors, which looks exactly
# like the tool being broken. (Happy's issue #120 is a user discovering this the
# expensive way.)
#
# Every variable that outranks the subscription login goes, not only the key.
# claude's auth order: a cloud provider switch (CLAUDE_CODE_USE_*: Bedrock,
# Vertex, Foundry, Anthropic AWS, Anthropic Google Cloud, Mantle, gateway),
# then ANTHROPIC_AUTH_TOKEN, ANTHROPIC_API_KEY, the apiKeyHelper, and
# CLAUDE_CODE_OAUTH_TOKEN, all above the /login credentials. The installed
# claude also reads the key and the OAuth token from a file descriptor an SDK
# host names (CLAUDE_CODE_API_KEY_FILE_DESCRIPTOR,
# CLAUDE_CODE_OAUTH_TOKEN_FILE_DESCRIPTOR), at the same rank. Fleet processes in
# AUTH_MODE=enterprise carry CLAUDE_CODE_OAUTH_TOKEN (the Enterprise seat's
# token), so leaving it set would run this session on that seat, without the
# connectors. Four more outrank the stored login in the installed claude 2.1.287
# (read from its binary, 2026-10-02): ANTHROPIC_UNIX_SOCKET,
# ANTHROPIC_FEDERATION_RULE_ID, ANTHROPIC_ORGANIZATION_ID and ANTHROPIC_PROFILE.
# The helper is not an environment variable: it lives in a settings.json, and
# CLAUDE_CONFIG_DIR below points at the subscription config dir, where the
# fleet keeps none.
#
# An Anthropic profile store can outrank the login too (claude 2.1.287, read
# from its binary on 2026-10-03). claude looks for the store at
# $ANTHROPIC_CONFIG_DIR, else $XDG_CONFIG_HOME/anthropic, else
# $HOME/.config/anthropic. A variable counts only when it is non-empty after
# trimming surrounding whitespace, and claude uses the trimmed value. With
# ANTHROPIC_PROFILE unset, a store whose active profile uses OIDC federation
# runs claude on that profile instead of the claude.ai login, and claude says
# nothing. ANTHROPIC_CONFIG_DIR only names the store, so it goes.
# XDG_CONFIG_HOME stays: git, gh and other tools in the session read their
# config through it, and without it claude would read $HOME/.config/anthropic
# instead. The store check before exec covers the path claude then reads.
#
# CLAUDE_API_PARENT_SID and CLAUDE_API_SPAWNER_SID must go too: claude-api
# reads them as this session's worker lineage / direct spawner, so leaving them
# set would file this session's own delegated runs and questions under the
# wrong parent. (PARENT_SID also used to stand down the subagent gate, which
# was retired 2026-08-15 when the fleet moved to API billing for good.)
#
# So must the calling Claude Code session's own variables. claude-sub runs from
# inside a session (a handler's Bash tool), and these describe that session,
# not the new one: CLAUDECODE, CLAUDE_CODE_ENTRYPOINT, CLAUDE_CODE_SESSION_ID,
# CLAUDE_CODE_SESSION_ATTENDED, CLAUDE_CODE_CHILD_SESSION,
# CLAUDE_AGENT_SDK_VERSION, CLAUDE_CODE_EXECPATH, CLAUDE_PID (the caller's
# claude process), and its messaging socket and token
# (CLAUDE_CODE_MESSAGING_SOCKET, CLAUDE_CODE_MESSAGING_TOKEN). The run
# here is a separate one-shot session and must not start as part of the caller.
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_BASE_URL \
      CLAUDE_CODE_API_KEY_FILE_DESCRIPTOR CLAUDE_CODE_OAUTH_TOKEN_FILE_DESCRIPTOR \
      CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY \
      CLAUDE_CODE_USE_ANTHROPIC_AWS CLAUDE_CODE_USE_ANTHROPIC_GOOGLE_CLOUD \
      CLAUDE_CODE_USE_MANTLE CLAUDE_CODE_USE_GATEWAY \
      ANTHROPIC_UNIX_SOCKET ANTHROPIC_FEDERATION_RULE_ID ANTHROPIC_ORGANIZATION_ID ANTHROPIC_PROFILE \
      ANTHROPIC_CONFIG_DIR \
      CLAUDE_API_PARENT_SID CLAUDE_API_SPAWNER_SID \
      CLAUDECODE CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_SESSION_ID CLAUDE_CODE_SESSION_ATTENDED \
      CLAUDE_CODE_CHILD_SESSION CLAUDE_AGENT_SDK_VERSION CLAUDE_CODE_EXECPATH CLAUDE_PID \
      CLAUDE_CODE_MESSAGING_SOCKET CLAUDE_CODE_MESSAGING_TOKEN
export CLAUDE_CONFIG_DIR="${CLAUDE_SUB_CONFIG_DIR:-$HOME/.claude}"

# The login check (header: THE LOGIN MUST BE JULIAN'S PERSONAL SUBSCRIPTION).
# python3 prints only the subscriptionType, and only when it is a plain
# lowercase name: a value of any other shape is not named in the refusal. Every
# other outcome is an exit code, so nothing else from the file reaches a
# variable or the terminal.
sub_type="$(python3 - "$CLAUDE_CONFIG_DIR/.credentials.json" <<'PY'
import json, re, sys
try:
    with open(sys.argv[1]) as f:
        oauth = json.load(f).get("claudeAiOauth")
except FileNotFoundError:
    sys.exit(10)
except OSError:
    sys.exit(11)
except (ValueError, AttributeError):   # not JSON, or JSON that is not an object
    sys.exit(12)
t = oauth.get("subscriptionType") if isinstance(oauth, dict) else None
if t is None or t == "":
    sys.exit(13)
if not isinstance(t, str) or not re.fullmatch(r"[a-z][a-z0-9_-]{0,31}", t):
    sys.exit(14)
print(t)
PY
)"
check_rc=$?
if [ "$check_rc" -ne 0 ] || { [ "$sub_type" != max ] && [ "$sub_type" != pro ]; }; then
  case "$check_rc" in
    0)  detail="its login is subscription type \"$sub_type\"" ;;
    10) detail="its .credentials.json does not exist" ;;
    11) detail="its .credentials.json cannot be read" ;;
    12) detail="its .credentials.json is malformed" ;;
    13) detail="its .credentials.json has no claudeAiOauth.subscriptionType" ;;
    14) detail="its subscription type is not a plain name (value not shown)" ;;
    *)  detail="python3 could not check its login (exit $check_rc)" ;;
  esac
  login_cmd="claude"
  [ "$CLAUDE_CONFIG_DIR" = "$HOME/.claude" ] || login_cmd="CLAUDE_CONFIG_DIR=$CLAUDE_CONFIG_DIR claude"
  echo "claude-sub: refused. It needs Julian's personal claude.ai login (subscription type max or pro) in $CLAUDE_CONFIG_DIR, but $detail. Fix: in a devbox terminal run $login_cmd, type /login, choose the claude.ai subscription and sign in with the personal account." >&2
  exit 3
fi

# The profile store check (the comment above the unset list says why). The path
# is the one the child claude reads now that ANTHROPIC_CONFIG_DIR is gone:
# $XDG_CONFIG_HOME/anthropic, else $HOME/.config/anthropic, each variable with
# surrounding whitespace trimmed (claude trims too; its trim also takes
# Unicode spaces); no check when both are empty. Anything at the
# path refuses: a directory, a file or a dangling symlink. Nothing inside is
# read. Existence alone refuses, so a new store layout in a later claude cannot
# slip past the check.
trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; printf '%s' "${s%"${s##*[![:space:]]}"}"; }
xdg="$(trim "${XDG_CONFIG_HOME-}")"
home_dir="$(trim "${HOME-}")"
store=""
if [ -n "$xdg" ]; then
  store="$xdg/anthropic"
elif [ -n "$home_dir" ]; then
  store="$home_dir/.config/anthropic"
fi
if [ -n "$store" ] && { [ -e "$store" ] || [ -L "$store" ]; }; then
  echo "claude-sub: refused. An Anthropic profile store exists at $store, and claude can run on a profile from it instead of the subscription login, without saying so. Fix: move $store away (claude-sub never reads it), or point XDG_CONFIG_HOME at a directory without an anthropic store for this run." >&2
  exit 3
fi

exec claude -p "$prompt" "$@"
