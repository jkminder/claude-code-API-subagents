#!/usr/bin/env bash
# Retired. This command used to store the worker API key on the machine. Since
# the Fellows security reset (2026-09-06) no API key may live in any file, and
# Keychain is not used: workers fetch the key at runtime — Claude Code runs the
# `apiKeyHelper` in the worker config dir's settings.json (~/.claude-api by
# default), an `op read` from 1Password under with-op. This file and the
# `claude-api-store-key` link stay so old references fail loudly here instead of
# with "command not found". It writes nothing and exits 2.
set -u
CONFIG_DIR="${CLAUDE_API_CONFIG_DIR:-$HOME/.claude-api}"
cat >&2 <<EOF
store-key: retired — API keys are never stored in a file (Fellows security reset 2026-09-06). Nothing was written.
  Workers fetch the key at runtime through the apiKeyHelper in $CONFIG_DIR/settings.json —
  a command that prints the key, fetched from 1Password under with-op:
    "apiKeyHelper": "$HOME/.local/bin/with-op op read 'op://<vault>/<item>/credential'"
  Verify with:  claude-api doctor   (runs the helper once, never prints the key).
EOF
exit 2
