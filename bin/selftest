#!/usr/bin/env bash
# Validation matrix (dispatched as: claude-api selftest). Re-verifies the
# version-pinned behaviors the framework depends on — run after Claude Code
# upgrades. Spends a few API-billed sonnet/haiku runs; the supervision-protocol
# checks (7-9) and the guard/shim checks (11-16) use stub workers and are free.
# SELFTEST_SKIP_LIVE=1 skips checks 1-10 and runs only 11-16, which need no API
# key and never spawn a real claude — use it to iterate on the shim checks.
set -uo pipefail

SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do
  dir="$(cd "$(dirname "$SRC")" && pwd)"
  SRC="$(readlink "$SRC")"
  case "$SRC" in /*) ;; *) SRC="$dir/$SRC" ;; esac
done
BIN_DIR="$(cd "$(dirname "$SRC")" && pwd)"
CA="$BIN_DIR/claude-api"
WORK="$(mktemp -d)"
# Defense against running inside a `claude-api run` worker: the parent's slug
# must not leak into spawns made here (it would rename registered sessions and
# break the interactive-argv assertions in check 13).
unset CLAUDE_API_RUN_SLUG
fails=0
trap '[ "$fails" -eq 0 ] && rm -rf "$WORK" || echo "artifacts kept in $WORK"' EXIT
cd "$WORK"

# Poll for a pattern in a growing file. Deliberately NOT `tail -f | grep -q`:
# that pipeline hangs when the match is the last line ever written (grep exits,
# tail blocks forever, the shell waits on both).
wait_for() { # file pattern timeout_secs
  local f="$1" pat="$2" t="${3:-120}" i=0
  while [ "$i" -lt "$t" ]; do
    grep -q -E "$pat" "$f" 2>/dev/null && return 0
    sleep 1; i=$((i + 1))
  done
  return 1
}

# Standing down a check needs the same evidence as reporting one. Three checks
# in this file were disabled this week on justifications that were all wrong
# (the model gate, check 16's worker safety, check 13's parent name), and every
# one survived review because a disabled check is green either way. If a check
# cannot run somewhere, prove what it sees there before you skip it.
step() { echo; echo "== $1"; }
ok()   { echo "   PASS"; }
bad()  { echo "   FAIL: $1"; fails=$((fails + 1)); }

[ -n "${SELFTEST_SKIP_LIVE:-}" ] && echo "SELFTEST_SKIP_LIVE set — running only the guard/shim checks (11-16)"

if [ -z "${SELFTEST_SKIP_LIVE:-}" ]; then

step "1/15 basic headless run + JSON output"
SID=""
if "$CA" -p 'Reply with exactly: SELFTEST OK' --model sonnet --output-format json > t1.json 2> t1.err \
   && python3 -c 'import json;d=json.load(open("t1.json"));assert not d.get("is_error");assert "SELFTEST OK" in d["result"]' 2>/dev/null; then
  ok
  SID="$(python3 -c 'import json;print(json.load(open("t1.json"))["session_id"])')"
else
  bad "basic run (t1.err)"
fi

step "2/15 --resume continuity"
if [ -n "$SID" ] \
   && "$CA" --resume "$SID" -p 'What exact phrase did you reply with earlier? Answer with just the phrase.' --model sonnet --output-format json > t2.json 2> t2.err \
   && python3 -c 'import json;assert "SELFTEST OK" in json.load(open("t2.json"))["result"]' 2>/dev/null; then
  ok
else
  bad "resume (t2.err)"
fi

step "3/15 acceptEdits floor: file creation"
mkdir -p edit && ( cd edit && "$CA" -p 'Create a file named hello.txt in the current directory containing exactly: selftest file
Then reply DONE.' --model sonnet --output-format json > ../t3.json 2> ../t3.err )
if [ "$(cat edit/hello.txt 2>/dev/null)" = "selftest file" ]; then ok; else bad "file not created (t3.err)"; fi

step "4/15 legacy manual FIFO: envelope + send helper + clean shutdown"
mkfifo w.in
tail -f /dev/null > w.in & keeper=$!
touch w.ndjson
"$CA" -p --input-format stream-json --output-format stream-json --verbose --model sonnet < w.in > w.ndjson 2> w.err & worker=$!
printf '%s\n' '{"type":"user","message":{"role":"user","content":"Reply with exactly: FIRST"}}' > w.in
if wait_for w.ndjson '"type":"assistant".*FIRST' 180; then
  # mid-run injection via the send helper (validates envelope, ENXIO check, delivery probe)
  if "$CA" send ./w.in 'Now reply with exactly: SECOND' > /dev/null 2>&1 \
     && wait_for w.ndjson '"type":"assistant".*SECOND' 180; then
    kill "$keeper" 2>/dev/null
    if wait_for w.ndjson '"type":"result"' 60; then ok; else bad "no result event after closing stdin (w.err)"; fi
  else
    kill "$keeper" 2>/dev/null
    bad "mid-run injected message got no reply (w.err)"
  fi
else
  kill "$keeper" 2>/dev/null
  bad "no assistant reply on FIFO (w.err) — stream-json envelope may have changed"
fi
kill "$worker" 2>/dev/null
wait 2>/dev/null

step "5/15 worker→human question relay from a run worker (ask grant + questions + answer)"
"$CA" run st-ask 'Run exactly this shell command with your Bash tool (set the tool call timeout to 120000 ms) and wait for it: claude-api ask --from selftest --timeout 90 "Reply with exactly: GRANTED". Then reply with exactly: GOT=<its stdout>.' \
  --model sonnet --allowedTools 'Bash(claude-api ask:*)' > t5.out 2> t5.err & qworker=$!
qid=""
i=0
while [ "$i" -lt 90 ]; do
  qid="$("$CA" questions 2>/dev/null | sed -n 's/^\[\(.*\)\] from=selftest.*/\1/p' | head -1)"
  [ -n "$qid" ] && break
  sleep 1; i=$((i + 1))
done
if [ -n "$qid" ] && "$CA" answer "$qid" "GRANTED" > /dev/null \
   && wait "$qworker" \
   && grep -q 'GOT' t5.out && grep -q 'GRANTED' t5.out; then
  ok
else
  [ -z "$qid" ] && bad "no question arrived — ask grant syntax may have changed (t5.err)" \
                || bad "answer did not flow back (t5.out / t5.err)"
fi
kill "$qworker" 2>/dev/null
wait 2>/dev/null
# Never leave selftest questions behind — a stale .q re-fires the runner's watcher.
QD="${CLAUDE_API_CONFIG_DIR:-$HOME/.claude-api}/run/workers/${CLAUDE_CODE_SESSION_ID:-}/questions"
[ -n "${CLAUDE_CODE_SESSION_ID:-}" ] || QD="${CLAUDE_API_CONFIG_DIR:-$HOME/.claude-api}/run/questions"
rm -f "$QD"/selftest-*.q "$QD"/selftest-*.a 2>/dev/null || true

# run-form checks. Worker artifacts live in the session worker dir; send/end
# take explicit paths so these also work from a plain terminal (no session id).
RWDIR="${CLAUDE_API_CONFIG_DIR:-$HOME/.claude-api}/run/workers/${CLAUDE_CODE_SESSION_ID:-manual}"

# send may hit the moment between run's mkfifo and its probe-fd open (ENXIO) —
# retry briefly before calling it a failure.
send_retry() { # fifo-path message [extra send args...]
  local f="$1" m="$2" i=0; shift 2
  while [ "$i" -lt 10 ]; do
    "$CA" send "$f" "$m" "$@" && return 0
    sleep 0.5; i=$((i + 1))
  done
  return 1
}

step "6/15 run: one-shot answer on stdout"
if "$CA" run st-one 'Reply with exactly: RUN OK' --model haiku > t6.out 2> t6.err \
   && [ "$(cat t6.out)" = "RUN OK" ] && grep -q 'resume:' t6.err \
   && [ ! -e "$RWDIR/st-one.in" ]; then
  ok
else
  bad "run one-shot (t6.out / t6.err)"
fi

fi # SELFTEST_SKIP_LIVE (checks 1-6)

# Steps 7-9 exercise the supervision protocol with a fake `claude` on PATH —
# deterministic timing, no API spend. Checks 11-12 and 14 reuse the stub, so
# it must sit outside both SKIP_LIVE blocks.
mkdir -p fakebin
cat > fakebin/claude <<'EOF'
#!/usr/bin/env bash
# selftest stub: stream-json worker, one result per input line; FAKE_MODE=crash
# dies mid-turn without a result; FAKE_MODE=parked ends the turn with an empty
# success result and stop_reason tool_use (a worker parked on a wakeup);
# FAKE_MODE=linger delivers its result but then never exits (the post-close
# wedge a native peer message can cause).
n=0
while IFS= read -r _; do
  n=$((n+1))
  if [ "${FAKE_MODE:-}" = crash ]; then
    printf '{"type":"assistant","session_id":"fake-sid"}\n'
    exit 3
  fi
  if [ "${FAKE_MODE:-}" = linger ]; then
    printf '{"type":"result","subtype":"success","is_error":false,"result":"TURN %s","session_id":"fake-sid","total_cost_usd":0}\n' "$n"
    exec sleep 90   # long enough that only the guard's TERM ends check 14 in time, short enough to bound the hang if the guard regresses
  fi
  if [ "${FAKE_MODE:-}" = dieafter ]; then
    printf '{"type":"result","subtype":"success","is_error":false,"result":"TURN %s","session_id":"fake-sid","total_cost_usd":0}\n' "$n"
    exit 7   # dies AFTER a successful result — the killed/died-post-result failure shape
  fi
  if [ "${FAKE_MODE:-}" = parked ]; then
    printf '{"type":"result","subtype":"success","is_error":false,"result":"","stop_reason":"tool_use","session_id":"fake-sid","total_cost_usd":0}\n'
    continue
  fi
  sleep "${FAKE_DELAY:-0.3}"
  printf '{"type":"result","subtype":"success","is_error":false,"result":"TURN %s","session_id":"fake-sid","total_cost_usd":0}\n' "$n"
done
EOF
chmod +x fakebin/claude

if [ -z "${SELFTEST_SKIP_LIVE:-}" ]; then

step "7/15 run: two sends queued during a slow turn — both drained before close (EOF drain)"
# The stub's slow first turn (FAKE_DELAY) guarantees both sends are queued in
# the pipe at the first result boundary; the close protocol must then give
# each its own turn instead of closing. (A live model can't test this
# deterministically: it either folds queued messages into the in-flight turn
# — content survives, result lines merge — or finishes turn 1 before the
# send lands, closing legitimately.)
PATH="$PWD/fakebin:$PATH" FAKE_DELAY=5 "$CA" run st-drain 'task one' > t7.out 2> t7.err & drpid=$!
i=0; while [ ! -p "$RWDIR/st-drain.in" ] && [ "$i" -lt 200 ]; do sleep 0.05; i=$((i + 1)); done
if send_retry "$RWDIR/st-drain.in" 'task two' > /dev/null 2>&1 \
   && "$CA" send "$RWDIR/st-drain.in" 'task three' > /dev/null 2>&1 \
   && wait "$drpid" \
   && [ "$(cat t7.out)" = "TURN 3" ] \
   && [ "$(grep -c '"type":"result"' "$RWDIR/st-drain.ndjson")" -eq 3 ]; then
  ok
else
  bad "a queued message was lost at close (t7.out / $RWDIR/st-drain.ndjson)"
fi

step "8/15 run: close handoff vs a racing send (fake reader)"
PATH="$PWD/fakebin:$PATH" "$CA" run st-race 'task one' > t8.out 2> t8.err & rcpid=$!
i=0; while ! grep -q '"TURN 1"' "$RWDIR/st-race.ndjson" 2>/dev/null && [ "$i" -lt 200 ]; do sleep 0.05; i=$((i + 1)); done
"$CA" send "$RWDIR/st-race.in" 'task two' > t8.send 2>&1; srrc=$?
wait "$rcpid"; rrc=$?
if [ "$srrc" -eq 0 ]; then
  # send won the race — its message must get its own turn and the final answer
  if [ "$rrc" -eq 0 ] && [ "$(cat t8.out)" = "TURN 2" ]; then
    ok
  else
    bad "send reported success but its message got no turn — SILENT LOSS (t8.out / t8.send)"
  fi
else
  # run won — the losing send must have failed loudly
  if grep -q 'gone\|not a FIFO\|nothing is reading' t8.send; then ok; else bad "racing send failed without a loud diagnostic (t8.send)"; fi
fi

step "9/15 run: worker crash mid-turn fails loudly"
FAKE_MODE=crash PATH="$PWD/fakebin:$PATH" "$CA" run st-crash 'boom' > t9.out 2> t9.err; crc=$?
if [ "$crc" -ne 0 ] && grep -q 'FAILED' t9.err && grep -q 'no-result-line' t9.err \
   && [ ! -e "$RWDIR/st-crash.in" ]; then
  ok
else
  bad "crash: rc=$crc, want nonzero + FAILED/no-result-line diagnostics + fifo removed (t9.err)"
fi

step "10/15 run --stay: steer mid-run, session named after slug, then graceful end"
"$CA" run st-steer 'Reply with exactly: FIRST' --stay --model haiku > t10.out 2> t10.err & stpid=$!
if wait_for "$RWDIR/st-steer.ndjson" '"type":"result"' 180; then
  # -n injection reached a real claude: the live session registered under the
  # slug. Scoped to a LIVE pid — the registry is shared and persistent, so a
  # stale entry from an uncleanly-dead earlier run must not green this check.
  named=0
  for _rf in "${CLAUDE_API_CONFIG_DIR:-$HOME/.claude-api}/sessions"/*.json; do
    [ -e "$_rf" ] || continue
    grep -qs '"name":"st-steer"' "$_rf" || continue
    _rp="$(basename "$_rf" .json)"
    case "$_rp" in *[!0-9]*) continue ;; esac
    kill -0 "$_rp" 2>/dev/null && { named=1; break; }
  done
  if send_retry "$RWDIR/st-steer.in" 'Reply with exactly: SECOND' --wait 180 > /dev/null 2>&1 \
     && "$CA" end "$RWDIR/st-steer.keeper" > /dev/null \
     && wait "$stpid" \
     && [ "$(cat t10.out)" = "SECOND" ] \
     && [ "$named" -eq 1 ] \
     && [ "$(grep -c '"type":"result"' "$RWDIR/st-steer.ndjson")" -ge 2 ]; then
    ok
  else
    [ "$named" -eq 0 ] && bad "worker session not registered as 'st-steer' (-n injection or registry broke)" \
                       || bad "steer/end (t10.out / t10.err)"
  fi
else
  kill "$stpid" 2>/dev/null
  bad "no first result from the --stay worker (t10.err)"
fi
wait 2>/dev/null
rm -f "$RWDIR"/st-ask.ndjson "$RWDIR"/st-one.ndjson "$RWDIR"/st-drain.ndjson \
      "$RWDIR"/st-race.ndjson "$RWDIR"/st-crash.ndjson "$RWDIR"/st-steer.ndjson \
      "$RWDIR"/st-ask.err "$RWDIR"/st-one.err "$RWDIR"/st-drain.err \
      "$RWDIR"/st-race.err "$RWDIR"/st-crash.err "$RWDIR"/st-steer.err 2>/dev/null || true

fi # SELFTEST_SKIP_LIVE (checks 7-10)

# checks 11-15 spawn no real claude and need no API key: the dirty-tree guard
# fires before any process is created, and the rest run against stub `claude`
# binaries. An isolated config dir with a dummy key keeps them off ~/.claude-api
# even if a guard regresses.
ISO="$WORK/isoconfig"
mkdir -p "$ISO"
printf 'sk-dummy-selftest\n' > "$ISO/api-key"
chmod 600 "$ISO/api-key"
IRWDIR="$ISO/run/workers/${CLAUDE_CODE_SESSION_ID:-manual}"

step "11/16 run: dirty-tree guard — refuses in a dirty repo, skipped outside a repo"
git init -q dirtyrepo
echo x > dirtyrepo/uncommitted.txt
( cd dirtyrepo && CLAUDE_API_CONFIG_DIR="$ISO" PATH="$WORK/fakebin:$PATH" "$CA" run st-dirty 'x' ) > t11.out 2> t11.err
drc=$?
mkdir -p notrepo
( cd notrepo && CLAUDE_API_CONFIG_DIR="$ISO" PATH="$WORK/fakebin:$PATH" "$CA" run st-nonrepo 'x' ) > t11b.out 2> t11b.err
nrc=$?
if [ "$drc" -eq 2 ] && grep -q 'worktree add' t11.err && grep -q -- '--allow-dirty' t11.err \
   && [ ! -s t11.out ] && [ ! -e "$IRWDIR/st-dirty.in" ] && [ ! -e "$IRWDIR/st-dirty.ndjson" ] \
   && [ "$nrc" -eq 0 ] && [ "$(cat t11b.out)" = "TURN 1" ]; then
  ok
else
  bad "dirty guard: dirty rc=$drc want 2 + refusal + no worker artifacts; non-repo rc=$nrc want 0 (t11.err / t11b.err)"
fi

step "12/16 run: failure shapes labeled correctly in the cost log (parked vs died-after-result)"
FAKE_MODE=parked PATH="$WORK/fakebin:$PATH" CLAUDE_API_CONFIG_DIR="$ISO" "$CA" run st-parked 'x' > t12.out 2> t12.err
prc=$?
FAKE_MODE=dieafter PATH="$WORK/fakebin:$PATH" CLAUDE_API_CONFIG_DIR="$ISO" "$CA" run st-dieafter 'x' > t12b.out 2> t12b.err
darc=$?
if [ "$prc" -eq 1 ] && grep -q 'cause: WORKER PARKED ITSELF' t12.err \
   && python3 -c 'import json,sys;assert any(e.get("task")=="st-parked" and e.get("failed")=="empty-result" for e in map(json.loads,open(sys.argv[1])))' "$ISO/cost-log.jsonl" 2>/dev/null \
   && [ "$darc" -eq 1 ] && grep -q 'FAILED' t12b.err && grep -q 'partial result' t12b.err \
   && python3 -c 'import json,sys;assert any(e.get("task")=="st-dieafter" and e.get("failed")=="exit-7" for e in map(json.loads,open(sys.argv[1])))' "$ISO/cost-log.jsonl" 2>/dev/null; then
  ok
else
  bad "failure labels: parked rc=$prc want 1 + failed=empty-result; dieafter rc=$darc want 1 + failed=exit-7, never empty-result (t12.err / t12b.err / $ISO/cost-log.jsonl)"
fi

step "13/16 headless injections: ScheduleWakeup denial, briefing, -n slug on run spawns only"
mkdir -p argbin
cat > argbin/claude <<'EOF'
#!/usr/bin/env bash
# selftest stub: record argv (one per line) and exit
printf '%s\n' "$@" > "${FAKE_ARGV_OUT:?}"
EOF
chmod +x argbin/claude
# run spawn re-enters claude-api with -p → all injections must reach argv.
FAKE_ARGV_OUT="$WORK/t13run.argv" PATH="$WORK/argbin:$PATH" CLAUDE_API_CONFIG_DIR="$ISO" \
  "$CA" run st-argv 'x' > /dev/null 2>&1 || true
# caller-supplied -n suppresses the slug-name injection.
FAKE_ARGV_OUT="$WORK/t13nam.argv" PATH="$WORK/argbin:$PATH" CLAUDE_API_CONFIG_DIR="$ISO" \
  "$CA" run st-argv2 'x' -n myname > /dev/null 2>&1 || true
# interactive (no -p) → no injections.
FAKE_ARGV_OUT="$WORK/t13int.argv" PATH="$WORK/argbin:$PATH" CLAUDE_API_CONFIG_DIR="$ISO" \
  "$CA" < /dev/null > /dev/null 2>&1 || true
# Parent-name briefing: assert only when this shell's session is resolvable in
# the registry (otherwise the sentence is legitimately absent, e.g. plain
# terminal or the parent session restarted).
pname_ok=1
# The briefing names the session that SPAWNED the worker, and claude-api
# resolves that from CLAUDE_API_PARENT_SID when it is set (line 577,
# "never overwrite an inherited value"). Keying the expected name on this
# session's own id is what made the check fail inside a worker: the
# briefing said fleet-ops-handler and the test demanded the worker's own
# slug. Same fallback claude-api uses, so an interactive run is unchanged.
my_name="$(python3 - "$HOME/.claude/sessions" "${CLAUDE_API_PARENT_SID:-${CLAUDE_CODE_SESSION_ID:-}}" 2>/dev/null <<'PY'
import glob, json, sys
d, sid = sys.argv[1], sys.argv[2]
if sid:
    for f in glob.glob(d + "/*.json"):
        try:
            e = json.load(open(f))
        except Exception:
            continue
        if e.get("sessionId") == sid and e.get("name"):
            print(e["name"])
            break
PY
)"
if [ -n "$my_name" ]; then
  grep -x -A1 -- '--append-system-prompt' t13run.argv | grep -qF "agent named '$my_name'" || pname_ok=0
fi
if grep -x -A1 -- '--disallowedTools' t13run.argv | grep -qx 'ScheduleWakeup' \
   && grep -x -A1 -- '--append-system-prompt' t13run.argv | grep -q 'ScheduleWakeup never fires' \
   && grep -x -A1 -- '-n' t13run.argv | grep -qx 'st-argv' \
   && [ "$(grep -cx -- '-n' t13nam.argv)" -eq 1 ] \
   && grep -x -A1 -- '-n' t13nam.argv | grep -qx 'myname' \
   && [ "$pname_ok" -eq 1 ] \
   && [ -s t13int.argv ] \
   && ! grep -qx -- '-n' t13int.argv \
   && ! grep -qx -- '--disallowedTools' t13int.argv \
   && ! grep -qx -- '--append-system-prompt' t13int.argv; then
  ok
else
  [ "$pname_ok" -eq 0 ] && bad "parent-name sentence missing from the briefing despite a resolvable parent ('$my_name'; t13run.argv)" \
                        || bad "headless injections: missing/duplicated on the run spawn, or present interactively (t13run.argv / t13nam.argv / t13int.argv)"
fi

step "14/16 run: close-linger guard — post-close wedge terminated, run still succeeds"
lstart="$(date +%s)"
FAKE_MODE=linger PATH="$WORK/fakebin:$PATH" CLAUDE_API_CONFIG_DIR="$ISO" CLAUDE_API_CLOSE_GRACE=3 \
  "$CA" run st-linger 'x' > t14.out 2> t14.err
lrc=$?
lsecs=$(( $(date +%s) - lstart ))
if [ "$lrc" -eq 0 ] && [ "$(cat t14.out)" = "TURN 1" ] \
   && grep -q 'terminating it' t14.err && [ "$lsecs" -lt 60 ]; then
  ok
else
  bad "linger guard: rc=$lrc after ${lsecs}s — want rc 0, stdout TURN 1, 'terminating it' warning within 60s (t14.err)"
fi

echo
step "15/16 text args: file flags keep backticks out of the shell, and empty text is refused"
# A brief passed as a quoted argument is mangled by the CALLER's shell before
# run sees it, so the durable fix is to read it from a file. Guard both the
# file reading and the argument parsing around it: an earlier version of this
# flag put a '}' inside a ${1:?...} usage string, which silently swallowed the
# rest of the message into the slug.
printf 'Fix `parse_ts` so $HOME and $(date -Is) work.\n' > brief-ok.txt
: > brief-empty.txt
( cd dirtyrepo && CLAUDE_API_CONFIG_DIR="$ISO" PATH="$WORK/fakebin:$PATH" "$CA" run st-pf --prompt-file "$WORK/brief-ok.txt" ) > t15.out 2> t15.err
pfrc=$?
CLAUDE_API_CONFIG_DIR="$ISO" PATH="$WORK/fakebin:$PATH" "$CA" run st-pf-missing --prompt-file "$WORK/nope.txt" > t15b.out 2> t15b.err
misrc=$?
CLAUDE_API_CONFIG_DIR="$ISO" PATH="$WORK/fakebin:$PATH" "$CA" run st-pf-empty --prompt-file "$WORK/brief-empty.txt" > t15c.out 2> t15c.err
emprc=$?
# the dirty-tree refusal proves the slug survived parsing intact and the file
# was accepted; a mangled slug would have been rejected by the slug check first
# the same class one step to the side: send/ask/answer carry agent-written text
# too, so each takes a file flag and refuses a missing or empty one loudly
sendmiss=0; sendempty=0; askmiss=0; ansmiss=0
CLAUDE_API_CONFIG_DIR="$ISO" "$CA" send st-nope --message-file "$WORK/nope.txt"   > /dev/null 2> t15d.err || sendmiss=$?
CLAUDE_API_CONFIG_DIR="$ISO" "$CA" send st-nope --message-file "$WORK/brief-empty.txt" > /dev/null 2> t15e.err || sendempty=$?
CLAUDE_API_CONFIG_DIR="$ISO" "$CA" ask --question-file "$WORK/nope.txt"          > /dev/null 2> t15f.err || askmiss=$?
CLAUDE_API_CONFIG_DIR="$ISO" "$CA" answer abc --answer-file "$WORK/nope.txt"     > /dev/null 2> t15g.err || ansmiss=$?
# MEASURED, not asserted: 8/8 guards in this family fail this check when
# neutralised one at a time (sweep run against a throwaway worktree, never the
# live tools — claude-api on PATH is a symlink into this repo). Re-measure
# after adding a guard; "I mutation-test these" is a practice, the coverage
# number is a measurement.
# an empty positional must be refused too: the file path checks for it, and the
# parsing rewrite that added these flags briefly let "" through, which delivers
# a turn with nothing in it and looks like success on both sides
sendblank=0; sendws=0; ansblank=0; askws=0; runws=0; askempty=0; ansempty=0; badslug=0
# the slug becomes a filename, so its charset guard is what stops traversal
( cd dirtyrepo && CLAUDE_API_CONFIG_DIR="$ISO" PATH="$WORK/fakebin:$PATH" "$CA" run ../evil 'x' ) > /dev/null 2> t15o.err || badslug=$?
( cd dirtyrepo && CLAUDE_API_CONFIG_DIR="$ISO" PATH="$WORK/fakebin:$PATH" "$CA" run st-ws "   " ) > /dev/null 2> t15l.err || runws=$?
CLAUDE_API_CONFIG_DIR="$ISO" "$CA" ask --question-file "$WORK/brief-empty.txt"     > /dev/null 2> t15m.err || askempty=$?
CLAUDE_API_CONFIG_DIR="$ISO" "$CA" answer abc --answer-file "$WORK/brief-empty.txt" > /dev/null 2> t15n.err || ansempty=$?
CLAUDE_API_CONFIG_DIR="$ISO" "$CA" send st-nope ""    > /dev/null 2> t15h.err || sendblank=$?
CLAUDE_API_CONFIG_DIR="$ISO" "$CA" send st-nope "   " > /dev/null 2> t15i.err || sendws=$?
CLAUDE_API_CONFIG_DIR="$ISO" "$CA" answer abc ""      > /dev/null 2> t15j.err || ansblank=$?
CLAUDE_API_CONFIG_DIR="$ISO" "$CA" ask "   "          > /dev/null 2> t15k.err || askws=$?
if [ "$pfrc" -eq 2 ] && grep -q 'uncommitted changes' t15.err && ! grep -q 'slug must match' t15.err \
   && [ "$misrc" -eq 2 ] && grep -q 'cannot read prompt file' t15b.err \
   && [ "$emprc" -eq 2 ] && grep -q 'is empty' t15c.err \
   && [ "$sendmiss" -eq 2 ] && grep -q 'cannot read file' t15d.err \
   && [ "$sendempty" -eq 2 ] && grep -q 'is empty' t15e.err \
   && [ "$askmiss" -eq 2 ] && grep -q 'cannot read file' t15f.err \
   && [ "$ansmiss" -eq 2 ] && grep -q 'cannot read file' t15g.err \
   && grep -q 'refusing an empty message' t15h.err && grep -q 'refusing an empty message' t15i.err \
   && grep -q 'refusing an empty answer' t15j.err && grep -q 'usage: claude-api ask' t15k.err \
   && [ "$runws" -eq 2 ] && grep -q 'refusing an empty task' t15l.err \
   && [ "$askempty" -eq 2 ] && grep -q 'is empty' t15m.err \
   && [ "$ansempty" -eq 2 ] && grep -q 'is empty' t15n.err \
   && [ "$badslug" -eq 2 ] && grep -q 'slug must match' t15o.err; then
  ok
else
  bad "text args: files run=$pfrc/$misrc/$emprc send=$sendmiss/$sendempty ask=$askmiss answer=$ansmiss (want 2); empty text run=$runws send=$sendblank/$sendws answer=$ansblank ask=$askws/$askempty answer-file=$ansempty badslug=$badslug (t15*.err)"
fi

echo
step "16/16 subagent gate: normal types denied once, claude-code-guide only on a named cheap model"
# Free: pipes JSON into the hook, spawns nothing. The gate is fail-open — when
# it breaks, nothing visible happens and the only difference is which spawns
# run — so its behaviour is pinned here rather than left to manual checks.
GATE="$BIN_DIR/subagent-gate-hook"
export XDG_CACHE_HOME="$WORK/gate-cache"   # never touch the real marker files
# CLAUDE_API_PARENT_SID must be cleared per call: if selftest itself runs inside
# a worker, the gate exempts everything and every assertion below would pass
# without testing anything.
g() { # tool session subagent_type model -> DENY|ALLOW
  local out
  out=$(printf '{"tool_name":"%s","session_id":"%s","agent_id":"","tool_input":{"subagent_type":"%s","model":"%s"}}' \
        "$1" "$2" "$3" "$4" | env -u CLAUDE_API_PARENT_SID "$GATE" 2>/dev/null)
  [ -n "$out" ] && echo DENY || echo ALLOW
}
gworker=$(printf '{"tool_name":"Agent","session_id":"gw","tool_input":{"subagent_type":"general-purpose"}}' \
          | CLAUDE_API_PARENT_SID=parent-sid "$GATE" 2>/dev/null)
printf 'not json at all' | env -u CLAUDE_API_PARENT_SID "$GATE" > gate-bad.out 2> gate-bad.err; gbadrc=$?
gnorm1=$(g Agent g1 general-purpose "")      # first attempt: denied
gnorm2=$(g Agent g1 general-purpose "")      # deliberate re-run: allowed (speed bump)
gfork=$(g Agent g2 fork "")
gexplore=$(g Agent g3 Explore "")            # not exempt: a worker can search a repo
# with a cheap model too: an exempt type would ALLOW this, a gated one denies it,
# which is what separates "Explore is gated" from "Explore needs a cheap model"
gexplore2=$(g Agent g11 Explore sonnet)
gtask=$(g Task g4 general-purpose "")        # the older tool name
ggood=$(g Agent g5 claude-code-guide sonnet)
ghaiku=$(g Agent g6 claude-code-guide haiku)
gnomodel=$(g Agent g7 claude-code-guide "")  # the regression: omitted != cheap
gopus=$(g Agent g8 claude-code-guide opus)
gfable=$(g Agent g9 claude-code-guide fable)
gfable2=$(g Agent g9 claude-code-guide fable)  # wrong argument: denied every time
gbash=$(g Bash g10 "" "")                    # must not fire on other tools
if [ "$gnorm1" = DENY ] && [ "$gnorm2" = ALLOW ] && [ "$gfork" = DENY ] \
   && [ "$gexplore" = DENY ] && [ "$gexplore2" = DENY ] && [ "$gtask" = DENY ] \
   && [ "$ggood" = ALLOW ] && [ "$ghaiku" = ALLOW ] \
   && [ "$gnomodel" = DENY ] && [ "$gopus" = DENY ] \
   && [ "$gfable" = DENY ] && [ "$gfable2" = DENY ] \
   && [ "$gbash" = ALLOW ] && [ -z "$gworker" ] \
   && [ "$gbadrc" -eq 0 ] && [ ! -s gate-bad.out ]; then
  ok
else
  bad "gate: normal=$gnorm1/$gnorm2 fork=$gfork explore=$gexplore/$gexplore2 task=$gtask (want DENY/ALLOW/DENY/DENY/DENY/DENY); guide sonnet=$ggood haiku=$ghaiku nomodel=$gnomodel opus=$gopus fable=$gfable/$gfable2 (want ALLOW/ALLOW/DENY/DENY/DENY/DENY); bash=$gbash (want ALLOW); worker='$gworker' (want empty); malformed rc=$gbadrc (want 0)"
fi

echo
step "17/17 claude-sub: strips API auth and the worker marker before exec"
# claude-sub's one job is that boundary. The worker marker matters as much as
# the key: the subagent gate stands down on its bare presence, so leaving it
# set would let the subscription session fan out built-in subagents ungated
# (reviewer finding, 2026-08-14). A stub claude records what crosses.
mkdir -p subbin
cat > subbin/claude <<'EOF'
#!/usr/bin/env bash
echo "SID=[${CLAUDE_API_PARENT_SID:-unset}] KEY=[${ANTHROPIC_API_KEY:-unset}] TOK=[${ANTHROPIC_AUTH_TOKEN:-unset}] URL=[${ANTHROPIC_BASE_URL:-unset}] CFG=[${CLAUDE_CONFIG_DIR:-unset}]"
EOF
chmod +x subbin/claude
subout=$(CLAUDE_API_PARENT_SID=fake-worker ANTHROPIC_API_KEY=k ANTHROPIC_AUTH_TOKEN=t \
         ANTHROPIC_BASE_URL=u CLAUDE_SUB_CONFIG_DIR="$WORK/subcfg" \
         PATH="$WORK/subbin:$PATH" "$BIN_DIR/claude-sub" probe 2>/dev/null)
if [ "$subout" = "SID=[unset] KEY=[unset] TOK=[unset] URL=[unset] CFG=[$WORK/subcfg]" ]; then
  ok
else
  bad "claude-sub passed through: '$subout'"
fi

if [ "$fails" -eq 0 ]; then
  if [ -n "${SELFTEST_SKIP_LIVE:-}" ]; then
    echo "selftest: checks 11-17 passed (live checks 1-10 SKIPPED)"
  else
    echo "selftest: all 17 checks passed"
  fi
else
  echo "selftest: $fails check(s) FAILED"
fi
[ "$fails" -eq 0 ]
