#!/usr/bin/env bash
# Validation matrix (dispatched as: claude-api selftest). Re-verifies the
# version-pinned behaviors the framework depends on — run after Claude Code
# upgrades. Spends a few API-billed sonnet/haiku runs; the supervision-protocol
# checks (7-9) and the guard/shim checks (11-18) use stub workers and are free.
# SELFTEST_SKIP_LIVE=1 skips checks 1-10 and runs only 11-18, which need no API
# key and never spawn a real claude — use it to iterate on the shim checks.
# (`claude-api ask` spawns nothing either, so check 18 is in the free block.)
# The subagent gate and its check were retired 2026-08-15 (the fleet moved to
# API billing permanently, so there is no subscription billing left to guard).
set -uo pipefail

SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do
  dir="$(cd "$(dirname "$SRC")" && pwd)"
  SRC="$(readlink "$SRC")"
  case "$SRC" in /*) ;; *) SRC="$dir/$SRC" ;; esac
done
BIN_DIR="$(cd "$(dirname "$SRC")" && pwd)"
CA="$BIN_DIR/claude-api"
WORK="$(mktemp -d)"
# Defense against running inside a `claude-api run` worker: the parent's slug
# must not leak into spawns made here (it would rename registered sessions and
# break the interactive-argv assertions in check 13).
unset CLAUDE_API_RUN_SLUG
fails=0
trap '[ "$fails" -eq 0 ] && rm -rf "$WORK" || echo "artifacts kept in $WORK"' EXIT
cd "$WORK"

# Poll for a pattern in a growing file. Deliberately NOT `tail -f | grep -q`:
# that pipeline hangs when the match is the last line ever written (grep exits,
# tail blocks forever, the shell waits on both).
wait_for() { # file pattern timeout_secs
  local f="$1" pat="$2" t="${3:-120}" i=0
  while [ "$i" -lt "$t" ]; do
    grep -q -E "$pat" "$f" 2>/dev/null && return 0
    sleep 1; i=$((i + 1))
  done
  return 1
}

# Standing down a check needs the same evidence as reporting one. Three checks
# in this file were once disabled on justifications that were all wrong (the
# model gate, check 13's parent name, and the worker safety of the subagent-gate
# check that has since been retired), and every one survived review because a
# disabled check is green either way. If a check
# cannot run somewhere, prove what it sees there before you skip it.
step() { echo; echo "== $1"; }
ok()   { echo "   PASS"; }
bad()  { echo "   FAIL: $1"; fails=$((fails + 1)); }

[ -n "${SELFTEST_SKIP_LIVE:-}" ] && echo "SELFTEST_SKIP_LIVE set — running only the guard/shim checks (11-18)"

if [ -z "${SELFTEST_SKIP_LIVE:-}" ]; then

step "1/18 basic headless run + JSON output"
SID=""
if "$CA" -p 'Reply with exactly: SELFTEST OK' --model sonnet --output-format json > t1.json 2> t1.err \
   && python3 -c 'import json;d=json.load(open("t1.json"));assert not d.get("is_error");assert "SELFTEST OK" in d["result"]' 2>/dev/null; then
  ok
  SID="$(python3 -c 'import json;print(json.load(open("t1.json"))["session_id"])')"
else
  bad "basic run (t1.err)"
fi

step "2/18 --resume continuity"
if [ -n "$SID" ] \
   && "$CA" --resume "$SID" -p 'What exact phrase did you reply with earlier? Answer with just the phrase.' --model sonnet --output-format json > t2.json 2> t2.err \
   && python3 -c 'import json;assert "SELFTEST OK" in json.load(open("t2.json"))["result"]' 2>/dev/null; then
  ok
else
  bad "resume (t2.err)"
fi

step "3/18 acceptEdits floor: file creation"
mkdir -p edit && ( cd edit && "$CA" -p 'Create a file named hello.txt in the current directory containing exactly: selftest file
Then reply DONE.' --model sonnet --output-format json > ../t3.json 2> ../t3.err )
if [ "$(cat edit/hello.txt 2>/dev/null)" = "selftest file" ]; then ok; else bad "file not created (t3.err)"; fi

step "4/18 legacy manual FIFO: envelope + send helper + clean shutdown"
mkfifo w.in
tail -f /dev/null > w.in & keeper=$!
touch w.ndjson
"$CA" -p --input-format stream-json --output-format stream-json --verbose --model sonnet < w.in > w.ndjson 2> w.err & worker=$!
printf '%s\n' '{"type":"user","message":{"role":"user","content":"Reply with exactly: FIRST"}}' > w.in
if wait_for w.ndjson '"type":"assistant".*FIRST' 180; then
  # mid-run injection via the send helper (validates envelope, ENXIO check, delivery probe)
  if "$CA" send ./w.in 'Now reply with exactly: SECOND' > /dev/null 2>&1 \
     && wait_for w.ndjson '"type":"assistant".*SECOND' 180; then
    kill "$keeper" 2>/dev/null
    if wait_for w.ndjson '"type":"result"' 60; then ok; else bad "no result event after closing stdin (w.err)"; fi
  else
    kill "$keeper" 2>/dev/null
    bad "mid-run injected message got no reply (w.err)"
  fi
else
  kill "$keeper" 2>/dev/null
  bad "no assistant reply on FIFO (w.err) — stream-json envelope may have changed"
fi
kill "$worker" 2>/dev/null
wait 2>/dev/null

step "5/18 worker→human question relay from a run worker (ask grant + questions + answer)"
"$CA" run st-ask 'Run exactly this shell command with your Bash tool (set the tool call timeout to 120000 ms) and wait for it: claude-api ask --from selftest --timeout 90 "Reply with exactly: GRANTED". Then reply with exactly: GOT=<its stdout>.' \
  --model sonnet --allowedTools 'Bash(claude-api ask:*)' > t5.out 2> t5.err & qworker=$!
qid=""
i=0
while [ "$i" -lt 90 ]; do
  qid="$("$CA" questions 2>/dev/null | sed -n 's/^\[\(.*\)\] from=selftest.*/\1/p' | head -1)"
  [ -n "$qid" ] && break
  sleep 1; i=$((i + 1))
done
if [ -n "$qid" ] && "$CA" answer "$qid" "GRANTED" > /dev/null \
   && wait "$qworker" \
   && grep -q 'GOT' t5.out && grep -q 'GRANTED' t5.out; then
  ok
else
  [ -z "$qid" ] && bad "no question arrived — ask grant syntax may have changed (t5.err)" \
                || bad "answer did not flow back (t5.out / t5.err)"
fi
kill "$qworker" 2>/dev/null
wait 2>/dev/null
# Never leave selftest questions behind — a stale .q re-fires the runner's watcher.
QD="${CLAUDE_API_CONFIG_DIR:-$HOME/.claude-api}/run/workers/${CLAUDE_CODE_SESSION_ID:-}/questions"
[ -n "${CLAUDE_CODE_SESSION_ID:-}" ] || QD="${CLAUDE_API_CONFIG_DIR:-$HOME/.claude-api}/run/questions"
rm -f "$QD"/selftest-*.q "$QD"/selftest-*.a 2>/dev/null || true

# run-form checks. Worker artifacts live in the session worker dir; send/end
# take explicit paths so these also work from a plain terminal (no session id).
RWDIR="${CLAUDE_API_CONFIG_DIR:-$HOME/.claude-api}/run/workers/${CLAUDE_CODE_SESSION_ID:-manual}"

# send may hit the moment between run's mkfifo and its probe-fd open (ENXIO) —
# retry briefly before calling it a failure.
send_retry() { # fifo-path message [extra send args...]
  local f="$1" m="$2" i=0; shift 2
  while [ "$i" -lt 10 ]; do
    "$CA" send "$f" "$m" "$@" && return 0
    sleep 0.5; i=$((i + 1))
  done
  return 1
}

step "6/18 run: one-shot answer on stdout"
if "$CA" run st-one 'Reply with exactly: RUN OK' --model haiku > t6.out 2> t6.err \
   && [ "$(cat t6.out)" = "RUN OK" ] && grep -q 'resume:' t6.err \
   && [ ! -e "$RWDIR/st-one.in" ]; then
  ok
else
  bad "run one-shot (t6.out / t6.err)"
fi

fi # SELFTEST_SKIP_LIVE (checks 1-6)

# Steps 7-9 exercise the supervision protocol with a fake `claude` on PATH —
# deterministic timing, no API spend. Checks 11-12 and 14 reuse the stub, so
# it must sit outside both SKIP_LIVE blocks.
mkdir -p fakebin
cat > fakebin/claude <<'EOF'
#!/usr/bin/env bash
# selftest stub: stream-json worker, one result per input line; FAKE_MODE=crash
# dies mid-turn without a result; FAKE_MODE=parked ends the turn with an empty
# success result and stop_reason tool_use (a worker parked on a wakeup);
# FAKE_MODE=linger delivers its result but then never exits (the post-close
# wedge a native peer message can cause).
n=0
while IFS= read -r _; do
  n=$((n+1))
  if [ "${FAKE_MODE:-}" = crash ]; then
    printf '{"type":"assistant","session_id":"fake-sid"}\n'
    exit 3
  fi
  if [ "${FAKE_MODE:-}" = linger ]; then
    printf '{"type":"result","subtype":"success","is_error":false,"result":"TURN %s","session_id":"fake-sid","total_cost_usd":0}\n' "$n"
    exec sleep 90   # long enough that only the guard's TERM ends check 14 in time, short enough to bound the hang if the guard regresses
  fi
  if [ "${FAKE_MODE:-}" = dieafter ]; then
    printf '{"type":"result","subtype":"success","is_error":false,"result":"TURN %s","session_id":"fake-sid","total_cost_usd":0}\n' "$n"
    exit 7   # dies AFTER a successful result — the killed/died-post-result failure shape
  fi
  if [ "${FAKE_MODE:-}" = parked ]; then
    printf '{"type":"result","subtype":"success","is_error":false,"result":"","stop_reason":"tool_use","session_id":"fake-sid","total_cost_usd":0}\n'
    continue
  fi
  sleep "${FAKE_DELAY:-0.3}"
  printf '{"type":"result","subtype":"success","is_error":false,"result":"TURN %s","session_id":"fake-sid","total_cost_usd":0}\n' "$n"
done
EOF
chmod +x fakebin/claude

if [ -z "${SELFTEST_SKIP_LIVE:-}" ]; then

step "7/18 run: two sends queued during a slow turn — both drained before close (EOF drain)"
# The stub's slow first turn (FAKE_DELAY) guarantees both sends are queued in
# the pipe at the first result boundary; the close protocol must then give
# each its own turn instead of closing. (A live model can't test this
# deterministically: it either folds queued messages into the in-flight turn
# — content survives, result lines merge — or finishes turn 1 before the
# send lands, closing legitimately.)
PATH="$PWD/fakebin:$PATH" FAKE_DELAY=5 "$CA" run st-drain 'task one' > t7.out 2> t7.err & drpid=$!
i=0; while [ ! -p "$RWDIR/st-drain.in" ] && [ "$i" -lt 200 ]; do sleep 0.05; i=$((i + 1)); done
if send_retry "$RWDIR/st-drain.in" 'task two' > /dev/null 2>&1 \
   && "$CA" send "$RWDIR/st-drain.in" 'task three' > /dev/null 2>&1 \
   && wait "$drpid" \
   && [ "$(cat t7.out)" = "TURN 3" ] \
   && [ "$(grep -c '"type":"result"' "$RWDIR/st-drain.ndjson")" -eq 3 ]; then
  ok
else
  bad "a queued message was lost at close (t7.out / $RWDIR/st-drain.ndjson)"
fi

step "8/18 run: close handoff vs a racing send (fake reader)"
PATH="$PWD/fakebin:$PATH" "$CA" run st-race 'task one' > t8.out 2> t8.err & rcpid=$!
i=0; while ! grep -q '"TURN 1"' "$RWDIR/st-race.ndjson" 2>/dev/null && [ "$i" -lt 200 ]; do sleep 0.05; i=$((i + 1)); done
"$CA" send "$RWDIR/st-race.in" 'task two' > t8.send 2>&1; srrc=$?
wait "$rcpid"; rrc=$?
if [ "$srrc" -eq 0 ]; then
  # send won the race — its message must get its own turn and the final answer
  if [ "$rrc" -eq 0 ] && [ "$(cat t8.out)" = "TURN 2" ]; then
    ok
  else
    bad "send reported success but its message got no turn — SILENT LOSS (t8.out / t8.send)"
  fi
else
  # run won — the losing send must have failed loudly
  if grep -q 'gone\|not a FIFO\|nothing is reading' t8.send; then ok; else bad "racing send failed without a loud diagnostic (t8.send)"; fi
fi

step "9/18 run: worker crash mid-turn fails loudly"
FAKE_MODE=crash PATH="$PWD/fakebin:$PATH" "$CA" run st-crash 'boom' > t9.out 2> t9.err; crc=$?
if [ "$crc" -ne 0 ] && grep -q 'FAILED' t9.err && grep -q 'no-result-line' t9.err \
   && [ ! -e "$RWDIR/st-crash.in" ]; then
  ok
else
  bad "crash: rc=$crc, want nonzero + FAILED/no-result-line diagnostics + fifo removed (t9.err)"
fi

step "10/18 run --stay: steer mid-run, session named after slug, then graceful end"
"$CA" run st-steer 'Reply with exactly: FIRST' --stay --model haiku > t10.out 2> t10.err & stpid=$!
if wait_for "$RWDIR/st-steer.ndjson" '"type":"result"' 180; then
  # -n injection reached a real claude: the live session registered under the
  # slug. Scoped to a LIVE pid — the registry is shared and persistent, so a
  # stale entry from an uncleanly-dead earlier run must not green this check.
  named=0
  for _rf in "${CLAUDE_API_CONFIG_DIR:-$HOME/.claude-api}/sessions"/*.json; do
    [ -e "$_rf" ] || continue
    grep -qs '"name":"st-steer"' "$_rf" || continue
    _rp="$(basename "$_rf" .json)"
    case "$_rp" in *[!0-9]*) continue ;; esac
    kill -0 "$_rp" 2>/dev/null && { named=1; break; }
  done
  if send_retry "$RWDIR/st-steer.in" 'Reply with exactly: SECOND' --wait 180 > /dev/null 2>&1 \
     && "$CA" end "$RWDIR/st-steer.keeper" > /dev/null \
     && wait "$stpid" \
     && [ "$(cat t10.out)" = "SECOND" ] \
     && [ "$named" -eq 1 ] \
     && [ "$(grep -c '"type":"result"' "$RWDIR/st-steer.ndjson")" -ge 2 ]; then
    ok
  else
    [ "$named" -eq 0 ] && bad "worker session not registered as 'st-steer' (-n injection or registry broke)" \
                       || bad "steer/end (t10.out / t10.err)"
  fi
else
  kill "$stpid" 2>/dev/null
  bad "no first result from the --stay worker (t10.err)"
fi
wait 2>/dev/null
rm -f "$RWDIR"/st-ask.ndjson "$RWDIR"/st-one.ndjson "$RWDIR"/st-drain.ndjson \
      "$RWDIR"/st-race.ndjson "$RWDIR"/st-crash.ndjson "$RWDIR"/st-steer.ndjson \
      "$RWDIR"/st-ask.err "$RWDIR"/st-one.err "$RWDIR"/st-drain.err \
      "$RWDIR"/st-race.err "$RWDIR"/st-crash.err "$RWDIR"/st-steer.err 2>/dev/null || true

fi # SELFTEST_SKIP_LIVE (checks 7-10)

# checks 11-15 spawn no real claude and need no API key: the dirty-tree guard
# fires before any process is created, and the rest run against stub `claude`
# binaries. An isolated config dir with a dummy key keeps them off ~/.claude-api
# even if a guard regresses.
ISO="$WORK/isoconfig"
mkdir -p "$ISO" "$ISO/run"
printf 'sk-dummy-selftest\n' > "$ISO/api-key"
chmod 600 "$ISO/api-key"
# claude-api refuses to spawn when the calling session recorded no permission
# mode (see check 17). These checks are about other things and read an isolated
# config dir the real hook never writes to, so seed the floor mode there.
if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
  printf 'acceptEdits' > "$ISO/run/permission-mode-$CLAUDE_CODE_SESSION_ID"
fi
IRWDIR="$ISO/run/workers/${CLAUDE_CODE_SESSION_ID:-manual}"

step "11/18 run: dirty-tree guard — refuses in a dirty repo, skipped outside a repo"
git init -q dirtyrepo
echo x > dirtyrepo/uncommitted.txt
( cd dirtyrepo && CLAUDE_API_CONFIG_DIR="$ISO" PATH="$WORK/fakebin:$PATH" "$CA" run st-dirty 'x' ) > t11.out 2> t11.err
drc=$?
mkdir -p notrepo
( cd notrepo && CLAUDE_API_CONFIG_DIR="$ISO" PATH="$WORK/fakebin:$PATH" "$CA" run st-nonrepo 'x' ) > t11b.out 2> t11b.err
nrc=$?
if [ "$drc" -eq 2 ] && grep -q 'worktree add' t11.err && grep -q -- '--allow-dirty' t11.err \
   && [ ! -s t11.out ] && [ ! -e "$IRWDIR/st-dirty.in" ] && [ ! -e "$IRWDIR/st-dirty.ndjson" ] \
   && [ "$nrc" -eq 0 ] && [ "$(cat t11b.out)" = "TURN 1" ]; then
  ok
else
  bad "dirty guard: dirty rc=$drc want 2 + refusal + no worker artifacts; non-repo rc=$nrc want 0 (t11.err / t11b.err)"
fi

step "12/18 run: failure shapes labeled correctly in the cost log (parked vs died-after-result)"
FAKE_MODE=parked PATH="$WORK/fakebin:$PATH" CLAUDE_API_CONFIG_DIR="$ISO" "$CA" run st-parked 'x' > t12.out 2> t12.err
prc=$?
FAKE_MODE=dieafter PATH="$WORK/fakebin:$PATH" CLAUDE_API_CONFIG_DIR="$ISO" "$CA" run st-dieafter 'x' > t12b.out 2> t12b.err
darc=$?
if [ "$prc" -eq 1 ] && grep -q 'cause: WORKER PARKED ITSELF' t12.err \
   && python3 -c 'import json,sys;assert any(e.get("task")=="st-parked" and e.get("failed")=="empty-result" for e in map(json.loads,open(sys.argv[1])))' "$ISO/cost-log.jsonl" 2>/dev/null \
   && [ "$darc" -eq 1 ] && grep -q 'FAILED' t12b.err && grep -q 'partial result' t12b.err \
   && python3 -c 'import json,sys;assert any(e.get("task")=="st-dieafter" and e.get("failed")=="exit-7" for e in map(json.loads,open(sys.argv[1])))' "$ISO/cost-log.jsonl" 2>/dev/null; then
  ok
else
  bad "failure labels: parked rc=$prc want 1 + failed=empty-result; dieafter rc=$darc want 1 + failed=exit-7, never empty-result (t12.err / t12b.err / $ISO/cost-log.jsonl)"
fi

step "13/18 headless injections: ScheduleWakeup denial, briefing, -n slug on run spawns only"
mkdir -p argbin
cat > argbin/claude <<'EOF'
#!/usr/bin/env bash
# selftest stub: record argv (one per line) and exit
printf '%s\n' "$@" > "${FAKE_ARGV_OUT:?}"
EOF
chmod +x argbin/claude
# run spawn re-enters claude-api with -p → all injections must reach argv.
FAKE_ARGV_OUT="$WORK/t13run.argv" PATH="$WORK/argbin:$PATH" CLAUDE_API_CONFIG_DIR="$ISO" \
  "$CA" run st-argv 'x' > /dev/null 2>&1 || true
# caller-supplied -n suppresses the slug-name injection.
FAKE_ARGV_OUT="$WORK/t13nam.argv" PATH="$WORK/argbin:$PATH" CLAUDE_API_CONFIG_DIR="$ISO" \
  "$CA" run st-argv2 'x' -n myname > /dev/null 2>&1 || true
# interactive (no -p) → no injections.
FAKE_ARGV_OUT="$WORK/t13int.argv" PATH="$WORK/argbin:$PATH" CLAUDE_API_CONFIG_DIR="$ISO" \
  "$CA" < /dev/null > /dev/null 2>&1 || true
# Parent-name briefing: assert only when this shell's session is resolvable in
# the registry (otherwise the sentence is legitimately absent, e.g. plain
# terminal or the parent session restarted).
pname_ok=1
# The briefing names the session that ACTUALLY executed the spawn — the
# caller's own CLAUDE_CODE_SESSION_ID. Run from a worker, that is the worker
# itself, not the CLAUDE_API_PARENT_SID it inherited (that id stays pinned to
# the lineage root — the ask relay's fallback/escalation inbox — and, at
# depth 2, names the grandparent: the misrouting the depth-2 assertions below
# pin down). Same fallback order claude-api uses, so an interactive run is
# unchanged.
my_name="$(python3 - "$HOME/.claude/sessions" "${CLAUDE_CODE_SESSION_ID:-${CLAUDE_API_PARENT_SID:-}}" 2>/dev/null <<'PY'
import glob, json, sys
d, sid = sys.argv[1], sys.argv[2]
if sid:
    for f in glob.glob(d + "/*.json"):
        try:
            e = json.load(open(f))
        except Exception:
            continue
        if e.get("sessionId") == sid and e.get("name"):
            print(e["name"])
            break
PY
)"
if [ -n "$my_name" ]; then
  grep -x -A1 -- '--append-system-prompt' t13run.argv | grep -qF "agent named '$my_name'" || pname_ok=0
fi
# Depth-2 regression: a worker spawning a sub-worker carries the grandparent's
# id in CLAUDE_API_PARENT_SID (inherited, never overwritten) and its own id in
# CLAUDE_CODE_SESSION_ID. The briefing must name the direct spawner (the
# caller's session), CLAUDE_API_PARENT_SID must reach the child UNCHANGED (it
# stays the lineage root — the ask relay's fallback/escalation inbox), and
# CLAUDE_API_SPAWNER_SID must reach the child OVERWRITTEN with the caller's
# sid (it routes the child's asks — check 18). Fixed 2026-08-17: the briefing
# used to resolve from PARENT_SID, telling a depth-2 worker its grandparent
# spawned it and misrouting its SendMessage pings.
d2_ok=1
D2HOME="$WORK/d2home"
mkdir -p "$D2HOME/.claude/sessions" envbin
cat > "$D2HOME/.claude/sessions/gp.json" <<'EOF'
{"sessionId": "d2-grandparent-sid", "name": "d2-grandparent"}
EOF
cat > "$D2HOME/.claude/sessions/parent.json" <<'EOF'
{"sessionId": "d2-parent-sid", "name": "d2-parent"}
EOF
cat > envbin/claude <<'EOF'
#!/usr/bin/env bash
# selftest stub: record argv and the lineage/spawner sids, then exit
printf '%s\n' "$@" > "${FAKE_ARGV_OUT:?}"
printf '%s\n%s\n' "${CLAUDE_API_PARENT_SID:-unset}" "${CLAUDE_API_SPAWNER_SID:-unset}" > "${FAKE_ENV_OUT:?}"
EOF
chmod +x envbin/claude
env FAKE_ARGV_OUT="$WORK/t13d2.argv" FAKE_ENV_OUT="$WORK/t13d2.env" \
    HOME="$D2HOME" PATH="$WORK/envbin:$PATH" CLAUDE_API_CONFIG_DIR="$ISO" \
    CLAUDE_API_PARENT_SID="d2-grandparent-sid" CLAUDE_CODE_SESSION_ID="d2-parent-sid" \
    "$CA" --permission-mode acceptEdits -p x < /dev/null > /dev/null 2> t13d2.err || true
grep -x -A1 -- '--append-system-prompt' t13d2.argv 2>/dev/null | grep -qF "agent named 'd2-parent'" || d2_ok=0
grep -q 'd2-grandparent' t13d2.argv 2>/dev/null && d2_ok=0
[ "$(cat t13d2.env 2>/dev/null)" = "d2-grandparent-sid
d2-parent-sid" ] || d2_ok=0
if grep -x -A1 -- '--disallowedTools' t13run.argv | grep -qx 'ScheduleWakeup' \
   && grep -x -A1 -- '--append-system-prompt' t13run.argv | grep -q 'ScheduleWakeup never fires' \
   && grep -x -A1 -- '-n' t13run.argv | grep -qx 'st-argv' \
   && [ "$(grep -cx -- '-n' t13nam.argv)" -eq 1 ] \
   && grep -x -A1 -- '-n' t13nam.argv | grep -qx 'myname' \
   && [ "$pname_ok" -eq 1 ] \
   && [ "$d2_ok" -eq 1 ] \
   && [ -s t13int.argv ] \
   && ! grep -qx -- '-n' t13int.argv \
   && ! grep -qx -- '--disallowedTools' t13int.argv \
   && ! grep -qx -- '--append-system-prompt' t13int.argv; then
  ok
elif [ "$pname_ok" -eq 0 ]; then
  bad "parent-name sentence missing from the briefing despite a resolvable parent ('$my_name'; t13run.argv)"
elif [ "$d2_ok" -eq 0 ]; then
  bad "depth-2: briefing must name the direct spawner (d2-parent), and the child must get PARENT_SID=d2-grandparent-sid unchanged plus SPAWNER_SID=d2-parent-sid overwritten (t13d2.argv / t13d2.env / t13d2.err)"
else
  bad "headless injections: missing/duplicated on the run spawn, or present interactively (t13run.argv / t13nam.argv / t13int.argv)"
fi

step "14/18 run: close-linger guard — post-close wedge terminated, run still succeeds"
lstart="$(date +%s)"
FAKE_MODE=linger PATH="$WORK/fakebin:$PATH" CLAUDE_API_CONFIG_DIR="$ISO" CLAUDE_API_CLOSE_GRACE=3 \
  "$CA" run st-linger 'x' > t14.out 2> t14.err
lrc=$?
lsecs=$(( $(date +%s) - lstart ))
if [ "$lrc" -eq 0 ] && [ "$(cat t14.out)" = "TURN 1" ] \
   && grep -q 'terminating it' t14.err && [ "$lsecs" -lt 60 ]; then
  ok
else
  bad "linger guard: rc=$lrc after ${lsecs}s — want rc 0, stdout TURN 1, 'terminating it' warning within 60s (t14.err)"
fi

echo
step "15/18 text args: file flags keep backticks out of the shell, and empty text is refused"
# A brief passed as a quoted argument is mangled by the CALLER's shell before
# run sees it, so the durable fix is to read it from a file. Guard both the
# file reading and the argument parsing around it: an earlier version of this
# flag put a '}' inside a ${1:?...} usage string, which silently swallowed the
# rest of the message into the slug.
printf 'Fix `parse_ts` so $HOME and $(date -Is) work.\n' > brief-ok.txt
: > brief-empty.txt
( cd dirtyrepo && CLAUDE_API_CONFIG_DIR="$ISO" PATH="$WORK/fakebin:$PATH" "$CA" run st-pf --prompt-file "$WORK/brief-ok.txt" ) > t15.out 2> t15.err
pfrc=$?
CLAUDE_API_CONFIG_DIR="$ISO" PATH="$WORK/fakebin:$PATH" "$CA" run st-pf-missing --prompt-file "$WORK/nope.txt" > t15b.out 2> t15b.err
misrc=$?
CLAUDE_API_CONFIG_DIR="$ISO" PATH="$WORK/fakebin:$PATH" "$CA" run st-pf-empty --prompt-file "$WORK/brief-empty.txt" > t15c.out 2> t15c.err
emprc=$?
# the dirty-tree refusal proves the slug survived parsing intact and the file
# was accepted; a mangled slug would have been rejected by the slug check first
# the same class one step to the side: send/ask/answer carry agent-written text
# too, so each takes a file flag and refuses a missing or empty one loudly
sendmiss=0; sendempty=0; askmiss=0; ansmiss=0
CLAUDE_API_CONFIG_DIR="$ISO" "$CA" send st-nope --message-file "$WORK/nope.txt"   > /dev/null 2> t15d.err || sendmiss=$?
CLAUDE_API_CONFIG_DIR="$ISO" "$CA" send st-nope --message-file "$WORK/brief-empty.txt" > /dev/null 2> t15e.err || sendempty=$?
CLAUDE_API_CONFIG_DIR="$ISO" "$CA" ask --question-file "$WORK/nope.txt"          > /dev/null 2> t15f.err || askmiss=$?
CLAUDE_API_CONFIG_DIR="$ISO" "$CA" answer abc --answer-file "$WORK/nope.txt"     > /dev/null 2> t15g.err || ansmiss=$?
# MEASURED, not asserted: 8/8 guards in this family fail this check when
# neutralised one at a time (sweep run against a throwaway worktree, never the
# live tools — claude-api on PATH is a symlink into this repo). Re-measure
# after adding a guard; "I mutation-test these" is a practice, the coverage
# number is a measurement.
# an empty positional must be refused too: the file path checks for it, and the
# parsing rewrite that added these flags briefly let "" through, which delivers
# a turn with nothing in it and looks like success on both sides
sendblank=0; sendws=0; ansblank=0; askws=0; runws=0; askempty=0; ansempty=0; badslug=0
# the slug becomes a filename, so its charset guard is what stops traversal
( cd dirtyrepo && CLAUDE_API_CONFIG_DIR="$ISO" PATH="$WORK/fakebin:$PATH" "$CA" run ../evil 'x' ) > /dev/null 2> t15o.err || badslug=$?
( cd dirtyrepo && CLAUDE_API_CONFIG_DIR="$ISO" PATH="$WORK/fakebin:$PATH" "$CA" run st-ws "   " ) > /dev/null 2> t15l.err || runws=$?
CLAUDE_API_CONFIG_DIR="$ISO" "$CA" ask --question-file "$WORK/brief-empty.txt"     > /dev/null 2> t15m.err || askempty=$?
CLAUDE_API_CONFIG_DIR="$ISO" "$CA" answer abc --answer-file "$WORK/brief-empty.txt" > /dev/null 2> t15n.err || ansempty=$?
CLAUDE_API_CONFIG_DIR="$ISO" "$CA" send st-nope ""    > /dev/null 2> t15h.err || sendblank=$?
CLAUDE_API_CONFIG_DIR="$ISO" "$CA" send st-nope "   " > /dev/null 2> t15i.err || sendws=$?
CLAUDE_API_CONFIG_DIR="$ISO" "$CA" answer abc ""      > /dev/null 2> t15j.err || ansblank=$?
CLAUDE_API_CONFIG_DIR="$ISO" "$CA" ask "   "          > /dev/null 2> t15k.err || askws=$?
if [ "$pfrc" -eq 2 ] && grep -q 'uncommitted changes' t15.err && ! grep -q 'slug must match' t15.err \
   && [ "$misrc" -eq 2 ] && grep -q 'cannot read prompt file' t15b.err \
   && [ "$emprc" -eq 2 ] && grep -q 'is empty' t15c.err \
   && [ "$sendmiss" -eq 2 ] && grep -q 'cannot read file' t15d.err \
   && [ "$sendempty" -eq 2 ] && grep -q 'is empty' t15e.err \
   && [ "$askmiss" -eq 2 ] && grep -q 'cannot read file' t15f.err \
   && [ "$ansmiss" -eq 2 ] && grep -q 'cannot read file' t15g.err \
   && grep -q 'refusing an empty message' t15h.err && grep -q 'refusing an empty message' t15i.err \
   && grep -q 'refusing an empty answer' t15j.err && grep -q 'usage: claude-api ask' t15k.err \
   && [ "$runws" -eq 2 ] && grep -q 'refusing an empty task' t15l.err \
   && [ "$askempty" -eq 2 ] && grep -q 'is empty' t15m.err \
   && [ "$ansempty" -eq 2 ] && grep -q 'is empty' t15n.err \
   && [ "$badslug" -eq 2 ] && grep -q 'slug must match' t15o.err; then
  ok
else
  bad "text args: files run=$pfrc/$misrc/$emprc send=$sendmiss/$sendempty ask=$askmiss answer=$ansmiss (want 2); empty text run=$runws send=$sendblank/$sendws answer=$ansblank ask=$askws/$askempty answer-file=$ansempty badslug=$badslug (t15*.err)"
fi

echo
step "16/18 claude-sub: strips API auth and the worker marker before exec"
# claude-sub's one job is that boundary. The worker marker matters as much as
# the key: claude-api reads it as "my parent session is this worker", so leaving
# it set would file the spawned session's runs and questions under the wrong
# parent. A stub claude records what crosses.
mkdir -p subbin
cat > subbin/claude <<'EOF'
#!/usr/bin/env bash
echo "SID=[${CLAUDE_API_PARENT_SID:-unset}] SPW=[${CLAUDE_API_SPAWNER_SID:-unset}] KEY=[${ANTHROPIC_API_KEY:-unset}] TOK=[${ANTHROPIC_AUTH_TOKEN:-unset}] URL=[${ANTHROPIC_BASE_URL:-unset}] CFG=[${CLAUDE_CONFIG_DIR:-unset}]"
EOF
chmod +x subbin/claude
subout=$(CLAUDE_API_PARENT_SID=fake-worker CLAUDE_API_SPAWNER_SID=fake-spawner \
         ANTHROPIC_API_KEY=k ANTHROPIC_AUTH_TOKEN=t \
         ANTHROPIC_BASE_URL=u CLAUDE_SUB_CONFIG_DIR="$WORK/subcfg" \
         PATH="$WORK/subbin:$PATH" "$BIN_DIR/claude-sub" probe 2>/dev/null)
if [ "$subout" = "SID=[unset] SPW=[unset] KEY=[unset] TOK=[unset] URL=[unset] CFG=[$WORK/subcfg]" ]; then
  ok
else
  bad "claude-sub passed through: '$subout'"
fi

echo
step "17/18 permission mode: hook→worker inheritance, and a loud refusal when nothing was recorded"
# Free: the stub `claude` from check 13 just records argv. The whole point is
# that the failure mode here used to be SILENT — a session whose config dir has
# no permission-mode hook (the fleet's ~/.claude-api sessions) got workers on the
# acceptEdits floor instead of the elevated mode it was running in, and only
# found out when a worker hit a denied tool call. So: real hook, real mode file,
# real resolution, and an assertion that the absent-record case exits nonzero.
PM_ISO="$WORK/pmconfig"
mkdir -p "$PM_ISO/run"
printf 'sk-dummy-selftest\n' > "$PM_ISO/api-key"
chmod 600 "$PM_ISO/api-key"
PM_SID="pm-selftest-sid"
pm_argv() { # -> writes $WORK/pm.argv, echoes rc
  local rc=0
  env FAKE_ARGV_OUT="$WORK/pm.argv" PATH="$WORK/argbin:$PATH" \
      CLAUDE_API_CONFIG_DIR="$PM_ISO" CLAUDE_CODE_SESSION_ID="$PM_SID" \
      "$CA" "$@" -p x < /dev/null > "$WORK/pm.out" 2> "$WORK/pm.err" || rc=$?
  echo "$rc"
}
pm_mode() { # -> the --permission-mode value that reached argv, or empty
  grep -x -A1 -- '--permission-mode' "$WORK/pm.argv" 2>/dev/null | sed -n '2p'
}
PMF="$PM_ISO/run/permission-mode-$PM_SID"

# 1. Nothing recorded for this session → refuse, name the cause, spawn nothing.
rm -f "$PMF" "$WORK/pm.argv"
norec_rc=$(pm_argv); norec_err="$(cat "$WORK/pm.err")"; norec_argv_exists=0
[ -e "$WORK/pm.argv" ] && norec_argv_exists=1
# 2. The hook records an elevated mode → the worker inherits it (real hook run).
printf '{"session_id":"%s","permission_mode":"bypassPermissions"}' "$PM_SID" \
  | CLAUDE_API_CONFIG_DIR="$PM_ISO" "$BIN_DIR/permission-mode-hook" > /dev/null 2>&1
hook_wrote=0; [ -f "$PMF" ] && hook_wrote=1
byp_rc=$(pm_argv); byp_mode="$(pm_mode)"
# 3. A non-elevated parent mode → the documented acceptEdits floor, quietly.
printf 'default' > "$PMF"
def_rc=$(pm_argv); def_mode="$(pm_mode)"
# 4. A mode this wrapper does not know → refuse rather than guess a privilege level.
printf 'warpDrive' > "$PMF"
unk_rc=$(pm_argv); unk_err="$(cat "$WORK/pm.err")"
# 5. A symlinked mode file (another user pre-planting one) → refuse to read it.
printf 'bypassPermissions' > "$WORK/planted"
rm -f "$PMF"; ln -s "$WORK/planted" "$PMF"
sym_rc=$(pm_argv); sym_err="$(cat "$WORK/pm.err")"
rm -f "$PMF"
# 6. An explicit flag is the documented escape hatch: it must work with no record.
exp_rc=$(pm_argv --permission-mode acceptEdits); exp_mode="$(pm_mode)"
# 7. Outside any Claude Code session there is nothing to inherit — floor, no error.
nosid_rc=0
env FAKE_ARGV_OUT="$WORK/pm2.argv" PATH="$WORK/argbin:$PATH" CLAUDE_API_CONFIG_DIR="$PM_ISO" \
  env -u CLAUDE_CODE_SESSION_ID "$CA" -p x < /dev/null > /dev/null 2> "$WORK/pm2.err" || nosid_rc=$?
nosid_mode="$(grep -x -A1 -- '--permission-mode' "$WORK/pm2.argv" 2>/dev/null | sed -n '2p')"
# 8. setup-worker must register the hook in the worker config dir too, not only
#    in ~/.claude — that was the actual gap: fleet sessions run with
#    CLAUDE_CONFIG_DIR=~/.claude-api and read only that settings.json, so their
#    mode was never recorded. Run the real installer inside a throwaway HOME
#    (it writes only under $HOME and the config dir) and run it twice, because a
#    registration that duplicates or fights the hook mirror on rerun is broken too.
PM_HOME="$WORK/pmhome"
mkdir -p "$PM_HOME"
HOME="$PM_HOME" CLAUDE_API_CONFIG_DIR="$PM_HOME/.claude-api" \
  "$BIN_DIR/setup-worker" > "$WORK/pm-setup1.out" 2>&1; setup1_rc=$?
HOME="$PM_HOME" CLAUDE_API_CONFIG_DIR="$PM_HOME/.claude-api" \
  "$BIN_DIR/setup-worker" > "$WORK/pm-setup2.out" 2>&1; setup2_rc=$?
reg_ok=0
if [ "$setup1_rc" -eq 0 ] && [ "$setup2_rc" -eq 0 ]; then
  python3 - "$PM_HOME/.claude/settings.json" "$PM_HOME/.claude-api/settings.json" <<'PY' && reg_ok=1
import json, sys
for path in sys.argv[1:]:
    cfg = json.load(open(path))
    groups = cfg.get("hooks", {}).get("PreToolUse", [])
    n = sum(1 for g in groups if isinstance(g, dict)
            for h in g.get("hooks", [])
            if isinstance(h, dict) and "permission-mode-hook" in h.get("command", ""))
    assert n == 1, "%s has %d permission-mode-hook registrations, want exactly 1" % (path, n)
PY
fi
if [ "$norec_rc" -eq 3 ] && [ "$norec_argv_exists" -eq 0 ] \
   && printf '%s' "$norec_err" | grep -q 'recorded no permission mode' \
   && [ "$hook_wrote" -eq 1 ] && [ "$byp_rc" -eq 0 ] && [ "$byp_mode" = bypassPermissions ] \
   && [ "$def_rc" -eq 0 ] && [ "$def_mode" = acceptEdits ] \
   && [ "$unk_rc" -eq 3 ] && printf '%s' "$unk_err" | grep -q 'warpDrive' \
   && [ "$sym_rc" -eq 3 ] && printf '%s' "$sym_err" | grep -q 'symlink' \
   && [ "$exp_rc" -eq 0 ] && [ "$exp_mode" = acceptEdits ] \
   && [ "$nosid_rc" -eq 0 ] && [ "$nosid_mode" = acceptEdits ] \
   && [ "$reg_ok" -eq 1 ]; then
  ok
else
  bad "permission mode: no-record rc=$norec_rc/argv=$norec_argv_exists (want 3/0), hook_wrote=$hook_wrote, inherit rc=$byp_rc mode='$byp_mode' (want 0/bypassPermissions), default rc=$def_rc mode='$def_mode' (want 0/acceptEdits), unknown rc=$unk_rc (want 3), symlink rc=$sym_rc (want 3), explicit rc=$exp_rc mode='$exp_mode' (want 0/acceptEdits), no-session rc=$nosid_rc mode='$nosid_mode' (want 0/acceptEdits), setup-worker registers exactly once in both config dirs=$reg_ok (setup rc $setup1_rc/$setup2_rc; $WORK/pm-setup1.out, $WORK/pm-setup2.out)"
fi

echo
step "18/18 ask routing: direct spawner's inbox at depth 2, root fallback + one escalation, depth-1 unchanged, total wait clamped to the budget"
# `ask` files a question and blocks — it spawns no claude, so this is free.
# A receivable spawner is a live, ownership-valid registry record: pid alive
# AND started before the record was written (a recycled pid starts only after
# its predecessor died). Three fake records exercise the gate:
#  - ask-parent-sid   → this shell's pid, record written now: receivable
#  - ask-dead-sid     → a reaped child's pid: dead, must fall back to the root
#  - ask-recycled-sid → this shell's pid but the record predates the process
#                       (mtime 2001): recycled pid, must fall back to the root
ASKHOME="$WORK/askhome"
mkdir -p "$ASKHOME/.claude/sessions"
printf '{"sessionId": "ask-parent-sid", "pid": %s, "name": "ask-parent"}\n' "$$" > "$ASKHOME/.claude/sessions/parent.json"
( : ) & askdead=$!
wait "$askdead" 2>/dev/null
printf '{"sessionId": "ask-dead-sid", "pid": %s}\n' "$askdead" > "$ASKHOME/.claude/sessions/dead.json"
printf '{"sessionId": "ask-recycled-sid", "pid": %s}\n' "$$" > "$ASKHOME/.claude/sessions/recycled.json"
touch -d '2001-01-01' "$ASKHOME/.claude/sessions/recycled.json"
IQ_ROOT="$ISO/run/workers/ask-root-sid/questions"
IQ_PARENT="$ISO/run/workers/ask-parent-sid/questions"
ask18() { # [VAR=val ...] cmd args — fake registry + root lineage preset
  env HOME="$ASKHOME" CLAUDE_API_CONFIG_DIR="$ISO" CLAUDE_API_PARENT_SID=ask-root-sid "$@"
}
wait_q() { # dir from-prefix → prints the qid once its .q exists
  local d="$1" p="$2" i=0 f
  while [ "$i" -lt 150 ]; do
    for f in "$d/$p"-*.q; do
      [ -e "$f" ] && { basename "$f" .q; return 0; }
    done
    sleep 0.1; i=$((i + 1))
  done
  return 1
}
ask_ok=1; ask_why=""
a18_fail() { ask_ok=0; [ -n "$ask_why" ] || ask_why="$1"; }
# (a) live spawner: the .q lands in the SPAWNER's inbox (never the root's),
# the filed line names the addressee, and the spawner's answer flows back.
ask18 CLAUDE_API_SPAWNER_SID=ask-parent-sid "$CA" ask --from t18live --timeout 30 'route?' > t18a.out 2> t18a.err & apid=$!
qid="$(wait_q "$IQ_PARENT" t18live)" || true
ls "$IQ_ROOT"/t18live-*.q > /dev/null 2>&1 && a18_fail "live: question leaked into the root inbox"
if [ -n "$qid" ]; then
  env CLAUDE_CODE_SESSION_ID=ask-parent-sid CLAUDE_API_CONFIG_DIR="$ISO" "$CA" answer "$qid" "ROUTED" > /dev/null 2>&1 || a18_fail "live: answer from the spawner refused"
else
  a18_fail "live: no .q appeared in the spawner's inbox"
fi
wait "$apid" || a18_fail "live: ask exited nonzero"
[ "$(cat t18a.out)" = "ROUTED" ] || a18_fail "live: wrong ask stdout"
grep -q 'ask-parent-sid' t18a.err || a18_fail "live: filed line does not name the spawner"
# (b) live spawner that never answers: after --timeout the ask escalates ONCE
# — the .q is re-filed (annotated) in the root's inbox and the root's answer
# is accepted.
ask18 CLAUDE_API_SPAWNER_SID=ask-parent-sid CLAUDE_API_ASK_ESCALATION_SECS=60 \
  "$CA" ask --from t18esc --timeout 2 'route?' > t18b.out 2> t18b.err & bpid=$!
qid2="$(wait_q "$IQ_ROOT" t18esc)" || true
if [ -n "$qid2" ]; then
  grep -q 'escalated' "$IQ_ROOT/$qid2.q" || a18_fail "esc: escalated copy lacks the escalation note"
  env CLAUDE_CODE_SESSION_ID=ask-root-sid CLAUDE_API_CONFIG_DIR="$ISO" "$CA" answer "$qid2" "ROOTED" > /dev/null 2>&1 || a18_fail "esc: answer from the root refused"
else
  a18_fail "esc: question never escalated into the root inbox"
fi
wait "$bpid" || a18_fail "esc: ask exited nonzero"
[ "$(cat t18b.out)" = "ROOTED" ] || a18_fail "esc: wrong ask stdout"
grep -q 'escalating once' t18b.err || a18_fail "esc: no escalation notice on stderr"
# (c) nobody answers either window: exit 124 and NO_ANSWER names BOTH addressees.
ask18 CLAUDE_API_SPAWNER_SID=ask-parent-sid CLAUDE_API_ASK_ESCALATION_SECS=2 \
  "$CA" ask --from t18noans --timeout 1 'route?' > t18c.out 2> t18c.err; noans_rc=$?
[ "$noans_rc" -eq 124 ] || a18_fail "noans: rc=$noans_rc want 124"
{ grep -q 'NO_ANSWER' t18c.out && grep -q 'ask-parent-sid' t18c.out && grep -q 'ask-root-sid' t18c.out; } || a18_fail "noans: NO_ANSWER must name both the spawner and the root"
# (d) dead spawner: immediate fallback — .q lands in the root's inbox, the
# root answers, and the filed line explains the fallback.
ask18 CLAUDE_API_SPAWNER_SID=ask-dead-sid "$CA" ask --from t18dead --timeout 30 'route?' > t18d.out 2> t18d.err & dpid=$!
qid3="$(wait_q "$IQ_ROOT" t18dead)" || true
ls "$IQ_PARENT"/t18dead-*.q > /dev/null 2>&1 && a18_fail "dead: question leaked into the dead spawner's inbox"
if [ -n "$qid3" ]; then
  env CLAUDE_CODE_SESSION_ID=ask-root-sid CLAUDE_API_CONFIG_DIR="$ISO" "$CA" answer "$qid3" "FELLBACK" > /dev/null 2>&1 || a18_fail "dead: answer from the root refused"
else
  a18_fail "dead: no .q appeared in the root inbox"
fi
wait "$dpid" || a18_fail "dead: ask exited nonzero"
[ "$(cat t18d.out)" = "FELLBACK" ] || a18_fail "dead: wrong ask stdout"
grep -q 'cannot receive' t18d.err || a18_fail "dead: filed line does not explain the fallback"
# (e) recycled pid: alive but not the record's writer — the ownership gate
# must refuse it and fall back to the root (no escalation on this path).
ask18 CLAUDE_API_SPAWNER_SID=ask-recycled-sid "$CA" ask --from t18rec --timeout 1 'route?' > t18e.out 2> t18e.err; rec_rc=$?
[ "$rec_rc" -eq 124 ] || a18_fail "recycled: rc=$rec_rc want 124"
{ grep -q 'cannot receive' t18e.out && grep -q 'ask-root-sid' t18e.out; } || a18_fail "recycled: NO_ANSWER must name the root and explain the refused spawner"
# (f) depth 1 (spawner == root, and spawner unset): byte-identical to the
# historical behavior — exactly the old filed line and the old NO_ANSWER text.
old_noans="NO_ANSWER: nobody replied within 1s — proceed with the default you stated in the question, or stop and report the open decision."
ask18 CLAUDE_API_SPAWNER_SID=ask-root-sid "$CA" ask --from t18d1a --timeout 1 'route?' > t18f.out 2> t18f.err; d1a_rc=$?
ask18 env -u CLAUDE_API_SPAWNER_SID "$CA" ask --from t18d1b --timeout 1 'route?' > t18g.out 2> t18g.err; d1b_rc=$?
for v in f g; do
  [ "$(cat "t18$v.out")" = "$old_noans" ] || a18_fail "depth-1($v): NO_ANSWER text changed"
  [ "$(grep -c . "t18$v.err")" -eq 1 ] || a18_fail "depth-1($v): extra stderr output"
  grep -Eq '^question filed as t18d1[ab]-[0-9]+-[0-9]+; waiting up to 1s for an answer$' "t18$v.err" || a18_fail "depth-1($v): filed line changed"
done
{ [ "$d1a_rc" -eq 124 ] && [ "$d1b_rc" -eq 124 ]; } || a18_fail "depth-1: rc=$d1a_rc/$d1b_rc want 124"
# depth-1 questions must have landed in the root inbox (the .q is cleaned on
# exit, so assert via the answer path being the ROOT's inbox in (a)/(d) above
# and via the unchanged messages here).
# (g) budget clamp, through the real script: a huge escalation env must be
# clamped so tmo + esc_window never exceeds the 570s default budget — the
# escalation notice prints the CLAMPED window (570 - 1 = 569), never 999999.
# Without the clamp, --timeout 540 (the default) + 180s escalation = 720s,
# and the 600s Bash tool cap kills the ask 60s into the escalation window —
# the EXIT trap then withdraws both .q copies and the asker gets a killed
# tool call instead of NO_ANSWER.
ask18 CLAUDE_API_SPAWNER_SID=ask-parent-sid CLAUDE_API_ASK_ESCALATION_SECS=999999 \
  "$CA" ask --from t18clamp --timeout 1 'route?' > t18h.out 2> t18h.err & hpid=$!
qid4="$(wait_q "$IQ_ROOT" t18clamp)" || true
if [ -n "$qid4" ]; then
  env CLAUDE_CODE_SESSION_ID=ask-root-sid CLAUDE_API_CONFIG_DIR="$ISO" "$CA" answer "$qid4" "CLAMPED" > /dev/null 2>&1 || a18_fail "clamp: answer from the root refused"
else
  a18_fail "clamp: question never escalated into the root inbox"
fi
wait "$hpid" || a18_fail "clamp: ask exited nonzero"
[ "$(cat t18h.out)" = "CLAMPED" ] || a18_fail "clamp: wrong ask stdout"
grep -q 'waiting another 569s' t18h.err || a18_fail "clamp: escalation window not clamped to budget - tmo (want 569s in t18h.err)"
# (h) no room left: when --timeout consumes the whole budget the escalation is
# skipped outright — announced on stderr, and the NO_ANSWER names the spawner
# and says the escalation was skipped for budget. No .q may reach the root.
ask18 CLAUDE_API_SPAWNER_SID=ask-parent-sid CLAUDE_API_ASK_BUDGET_SECS=2 CLAUDE_API_ASK_ESCALATION_SECS=180 \
  "$CA" ask --from t18skip --timeout 2 'route?' > t18i.out 2> t18i.err; skip_rc=$?
[ "$skip_rc" -eq 124 ] || a18_fail "skip: rc=$skip_rc want 124"
grep -q 'SKIPPED' t18i.err || a18_fail "skip: no skipped-escalation notice on stderr"
{ grep -q 'NO_ANSWER' t18i.out && grep -q 'ask-parent-sid' t18i.out && grep -q 'skipped' t18i.out; } || a18_fail "skip: NO_ANSWER must name the spawner and say the escalation was skipped"
ls "$IQ_ROOT"/t18skip-*.q > /dev/null 2>&1 && a18_fail "skip: a zero-window escalation still filed into the root inbox"
# (i) explicit over-budget timeout: cannot be clamped without breaking the
# caller's stated wait, so it must WARN loudly that the tool cap will kill
# the call — and otherwise proceed.
ask18 env -u CLAUDE_API_SPAWNER_SID CLAUDE_API_ASK_BUDGET_SECS=1 \
  "$CA" ask --from t18warn --timeout 2 'route?' > t18j.out 2> t18j.err; warn_rc=$?
[ "$warn_rc" -eq 124 ] || a18_fail "warn: rc=$warn_rc want 124"
{ grep -q 'WARNING' t18j.err && grep -q 'tool cap' t18j.err && grep -q 'KILL' t18j.err; } || a18_fail "warn: over-budget --timeout must warn that the tool cap will kill the call"
# (j) mutation check on the clamp: neutralise the clamp line in a throwaway
# copy of worker-ctl and prove sub-test (g)'s assertion catches it — the
# mutant must print the UNclamped 999999s window. If the sed no longer
# matches, the clamp line moved and this check must move with it.
WCTL="$BIN_DIR/worker-ctl"
sed '/esc_window" -gt "\$esc_room"/d' "$WCTL" > "$WORK/mut-ctl" && chmod +x "$WORK/mut-ctl"
if cmp -s "$WCTL" "$WORK/mut-ctl"; then
  a18_fail "mutation: sed removed nothing — the clamp line changed; update this check"
else
  ask18 CLAUDE_API_SPAWNER_SID=ask-parent-sid CLAUDE_API_ASK_ESCALATION_SECS=999999 \
    "$WORK/mut-ctl" ask --from t18mut --timeout 1 'route?' > t18k.out 2> t18k.err & mpid=$!
  qid5="$(wait_q "$IQ_ROOT" t18mut)" || true
  if [ -n "$qid5" ]; then
    env CLAUDE_CODE_SESSION_ID=ask-root-sid CLAUDE_API_CONFIG_DIR="$ISO" "$CA" answer "$qid5" "MUTANT" > /dev/null 2>&1 || a18_fail "mutation: answer to the mutant refused"
  else
    a18_fail "mutation: mutant never escalated"
  fi
  wait "$mpid" || a18_fail "mutation: mutant ask exited nonzero"
  grep -q 'waiting another 999999s' t18k.err || a18_fail "mutation: clamp-free mutant did NOT print the unclamped window — (g) would not catch a broken clamp"
fi
if [ "$ask_ok" -eq 1 ]; then
  ok
else
  bad "ask routing: $ask_why (t18*.out / t18*.err)"
fi

if [ "$fails" -eq 0 ]; then
  if [ -n "${SELFTEST_SKIP_LIVE:-}" ]; then
    echo "selftest: checks 11-18 passed (live checks 1-10 SKIPPED)"
  else
    echo "selftest: all 18 checks passed"
  fi
else
  echo "selftest: $fails check(s) FAILED"
fi
[ "$fails" -eq 0 ]
