#!/usr/bin/env python3
"""PreToolUse hook: interrupt the first built-in-subagent spawn per agent.

The built-in Agent tool bills Julian's subscription; `claude-api run` bills a
flat API credit pool. Julian's rule (2026-08-11): spawning a normal subagent is
forbidden unless he asked for one in the conversation — otherwise delegate with
`claude-api run`. This hook makes that a decision instead of a reflex.

Like pod-gate, it denies once per agent and lets a deliberate re-run through:
when Julian HAS asked for a subagent, re-running is the confirmation. It is a
speed bump, not a lock. See ../skills/delegate/SKILL.md.

What is actually verified, stated narrowly on purpose:

- This script emits the right decision for each input, pinned by selftest check
  16 and mutation-tested (2026-08-11).
- Workers do not see this hook: `claude-api` sets CLAUDE_CONFIG_DIR, so they
  read a different settings.json — a probe worker's Agent call went through
  untouched (2026-08-11).

Not verified by anyone: that Claude Code delivers permissionDecisionReason to
the calling agent (that is the documented contract, not something measured
here), and whether a denial is visible to Julian in his own UI at all. Both are
only measurable by triggering a gated spawn from a live session, which no agent
should do on its own initiative. "Tested" above means the script, not the path.
"""

import hashlib
import json
import os
import sys

# Both names are accepted: this harness calls the tool "Agent", older Claude
# Code called it "Task". Matching only the current name would make the gate
# vanish silently if the tool is ever renamed back.
SUBAGENT_TOOLS = {"Agent", "Task"}

# The one type a claude-api worker cannot replace: claude-code-guide answers
# from curated Claude Code documentation. Julian allows it (2026-08-11), but not
# on Fable. Explore is deliberately NOT here — a worker can search a repo just as
# well, so it goes through delegation like any other normal subagent.
ALLOWED_TYPES = {"claude-code-guide"}

CHEAP_MODELS = {"sonnet", "haiku"}

FABLE_MESSAGE = (
    "Julian, 2026-08-11: do not run {kind} on Fable, and name the model "
    "explicitly. Re-run with model: \"sonnet\", or \"haiku\" for a simple "
    "lookup. {why}\n"
    "An omitted model is refused rather than assumed cheap: it inherits "
    "whatever this session runs, so it cannot be shown not to be Fable — a "
    "session configured to Fable would produce one silently, which is the case "
    "this gate exists to stop."
)

MESSAGE = (
    "Built-in subagents bill Julian's subscription; claude-api workers bill a "
    "flat API pool. Julian's rule (2026-08-11): **normal subagents should never "
    "be used** — not general-purpose, not fork, not claude — unless he asked "
    "for one in this conversation.\n"
    "Did he, explicitly? If yes, re-run this exact call and it will go through. "
    "If no, delegate with `claude-api run <slug> --prompt-file <path>` "
    "(skills/delegate) — it is the same effort, one background Bash call. "
    "Wanting the answer in your own context is not a reason; ask him if you "
    "think this job is the exception.\n"
    "Only one type is allowed without asking: subagent_type "
    "\"claude-code-guide\" (Claude Code documentation), and only with model: "
    "\"sonnet\" or \"haiku\", never Fable. Explore is not exempt — a worker can "
    "search a repo too."
)


def inside_worker():
    """True when this Claude Code process is a claude-api worker.

    A worker is already on API billing, and the delegate skill tells it to fan
    out with built-in subagents — that is the recommended pattern, not a misuse,
    so the gate must not fire there.

    Today this is a guard, not the thing doing the work: `claude-api` sets
    CLAUDE_CONFIG_DIR=~/.claude-api, so workers read a different settings.json
    and this hook is not installed for them at all (verified 2026-08-11 — a
    worker's Agent call went through untouched). The check exists so that
    mirroring the hook into the worker config later cannot silently break
    swarms.

    `claude-api` exports CLAUDE_API_PARENT_SID into the worker and never
    un-exports it (unlike CLAUDE_API_RUN_SLUG, which it deliberately drops), so
    its presence marks a worker process; a session Julian started himself does
    not have it (both verified 2026-08-11).
    """
    return bool(os.environ.get("CLAUDE_API_PARENT_SID", "").strip())


def state_dir():
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(
        os.path.expanduser("~"), ".cache")
    return os.path.join(base, "subagent-gate")


def first_attempt(payload):
    """Claim this agent's marker file. True only for the first claimer."""
    session = payload.get("session_id") or ""
    if not session:
        return True  # no identity to key on: treat every attempt as the first
    # Subagents share the parent's session_id but carry their own agent_id, so
    # each one gets its own interrupt instead of spending the session's.
    agent = payload.get("agent_id") or ""
    key = hashlib.sha256((session + "\x00" + agent).encode()).hexdigest()[:32]
    path = os.path.join(state_dir(), key)
    try:
        os.makedirs(state_dir(), mode=0o700, exist_ok=True)
        os.close(os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600))
    except FileExistsError:
        return False
    except OSError:
        return True  # cannot record state -> interrupt; the safe direction here
    return True


def main():
    payload = json.loads(sys.stdin.read())
    if payload.get("tool_name") not in SUBAGENT_TOOLS:
        return
    if inside_worker():
        return  # workers are told to fan out this way; see inside_worker()
    tool_input = payload.get("tool_input") or {}
    kind = str(tool_input.get("subagent_type") or "")
    if kind in ALLOWED_TYPES:
        # Allowed, but only on a named cheap model. Denied every time rather
        # than once: a wrong model argument is not a decision to reconsider, so
        # re-running unchanged must keep failing until the model changes.
        model = str(tool_input.get("model") or "").strip().lower()
        if model not in CHEAP_MODELS:
            deny(FABLE_MESSAGE.format(
                kind=kind,
                why=(f"{model!r} is not one of {sorted(CHEAP_MODELS)}."
                     if model else "No model was given.")))
        return
    if not first_attempt(payload):
        return  # already interrupted once; the agent re-ran it deliberately
    deny(MESSAGE)


def deny(reason):
    json.dump(
        {
            "hookSpecificOutput": {
                "hookEventName": "PreToolUse",
                "permissionDecision": "deny",
                "permissionDecisionReason": reason,
            }
        },
        sys.stdout,
    )


if __name__ == "__main__":
    try:
        main()
    except Exception:  # noqa: BLE001 — a broken gate must not brick the tool
        sys.exit(0)
