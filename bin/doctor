#!/usr/bin/env bash
# Install health check (dispatched as: claude-api doctor [--ping]).
# Verifies every load-bearing assumption without printing the key.
# --ping additionally does one live worker run (spends a little API credit).
set -uo pipefail

SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do
  dir="$(cd "$(dirname "$SRC")" && pwd)"
  SRC="$(readlink "$SRC")"
  case "$SRC" in /*) ;; *) SRC="$dir/$SRC" ;; esac
done
BIN_DIR="$(cd "$(dirname "$SRC")" && pwd)"
CONFIG_DIR="${CLAUDE_API_CONFIG_DIR:-$HOME/.claude-api}"

fails=0; warns=0
ok()   { echo "  ok    $1"; }
warn() { echo "  WARN  $1"; warns=$((warns + 1)); }
fail() { echo "  FAIL  $1"; fails=$((fails + 1)); }

echo "claude-api doctor"

if command -v claude >/dev/null 2>&1; then
  ok "claude on PATH ($(claude --version 2>/dev/null | head -1))"
else
  fail "claude not on PATH — npm install -g @anthropic-ai/claude-code"
fi

# API key source: the apiKeyHelper in the config dir's settings.json — Claude
# Code runs it in the worker process to fetch the key at runtime (an `op read`
# from 1Password under with-op). No key file, no Keychain (security reset
# 2026-09-06). Probe it once here so an op failure shows its reason; the key
# itself is never printed.
helper="$(python3 - "$CONFIG_DIR/settings.json" <<'PY' 2>/dev/null
import json, sys
try:
    v = json.load(open(sys.argv[1])).get("apiKeyHelper")
except Exception:
    v = None
print(v.strip() if isinstance(v, str) else "")
PY
)"
# AUTH_MODE (fleet.conf; Julian's D159 = C, 2026-10-02): enterprise = the
# Enterprise OAuth token in 1Password is what workers run on, and a leftover
# helper is a warning. claude-api empties the helper for a worker through the
# --settings it injects. A worker given its own --settings runs the helper, and
# bills the API key, unless that --settings carries "apiKeyHelper": "".
fleet_key() { # <KEY> <default>
  python3 - "$1" "$2" <<'PY' 2>/dev/null
import os, sys
key, default = sys.argv[1], sys.argv[2]
v = os.environ.get(key)
if v:
    print(v); sys.exit(0)
path = os.environ.get("FLEET_CONF") or os.path.expanduser("~/.config/fleet/fleet.conf")
val = default
try:
    for line in open(path):
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, _, raw = line.partition("=")
        if k.strip() != key:
            continue
        raw = raw.strip()
        if len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "\"'":
            raw = raw[1:-1]
        val = raw
except OSError:
    pass
print(val)
PY
}
# The OAUTH_TOKEN_REF rule claude-api applies (the same two functions): op://
# followed by exactly three non-empty segments (vault, item, field) separated by
# "/"; a segment may hold spaces but no "/", newline, carriage return or tab;
# 256 characters at most in all. Anything else may be a pasted token.
oauth_ref_ok() { # <ref>
  local re=$'^op://[^/\n\r\t]+/[^/\n\r\t]+/[^/\n\r\t]+$'
  [ "${#1}" -le 256 ] && [[ $1 =~ $re ]]
}
# op echoes the reference back on stderr, and a token can still ride inside a
# well-formed one (op://<token>/x/y): op's stderr is shown with the whole
# reference, then each of its three segments, longest first, replaced by <ref>.
# The reference reaches python on stdin, never on a command line.
redact_ref() { # <ref>; stdin: op's stderr → stdout: the same text, redacted
  { printf '%s\0' "$1"; cat; } | python3 -c '
import sys
ref, text = sys.stdin.buffer.read().decode("utf-8", "surrogateescape").split("\0", 1)
segs = ref[len("op://"):].split("/")
assert ref.startswith("op://") and len(segs) == 3 and all(segs), "redact_ref: a reference oauth_ref_ok refuses"
for s in sorted([ref] + segs, key=len, reverse=True):
    text = text.replace(s, "<ref>")
sys.stdout.buffer.write(text.encode("utf-8", "surrogateescape"))
'
}
AUTH_MODE="$(fleet_key AUTH_MODE api)"
if [ "$AUTH_MODE" != api ] && [ "$AUTH_MODE" != enterprise ]; then
  # claude-api refuses every spawn on this value; never shown (a token pasted
  # onto the AUTH_MODE line would land in this report)
  fail "AUTH_MODE (value not shown) is neither api nor enterprise, so claude-api refuses every spawn: set AUTH_MODE=api or AUTH_MODE=enterprise in fleet.conf (a variable of that name in the environment wins over the file)"
elif [ "$AUTH_MODE" = enterprise ]; then
  ref="$(fleet_key OAUTH_TOKEN_REF "")"
  # where the value came from (claude-api's rule): the environment when a
  # non-empty variable of that name is exported, else fleet.conf
  if [ -n "${OAUTH_TOKEN_REF:-}" ]; then
    ref_origin="the environment variable OAUTH_TOKEN_REF, which wins over the file"
    ref_fix="Fix or unset the exported OAUTH_TOKEN_REF"
  else
    ref_origin="${FLEET_CONF:-$HOME/.config/fleet/fleet.conf}"
    ref_fix="Set OAUTH_TOKEN_REF=op://<vault>/<item>/credential in ${FLEET_CONF:-$HOME/.config/fleet/fleet.conf}"
  fi
  if [ -n "$ref" ] && ! oauth_ref_ok "$ref"; then
    # possibly a token pasted in place of the reference or inside it: never
    # shown, never sent to op
    fail "OAUTH_TOKEN_REF is not an op:// reference (value not shown); it comes from $ref_origin. $ref_fix."
  elif [ -n "$ref" ]; then
    ok "AUTH_MODE=enterprise: OAUTH_TOKEN_REF set (not shown), from $ref_origin"
    WITH_OP="${CLAUDE_API_WITH_OP:-$(command -v with-op 2>/dev/null || echo "$HOME/.local/bin/with-op")}"
    tok_err="$(mktemp)"
    if tok="$("$WITH_OP" op read "$ref" 2>"$tok_err")" && [ -n "$tok" ]; then
      ok "the Enterprise token reads from 1Password (not shown; ${#tok} chars)"
    else
      fail "op cannot read the Enterprise token at the reference in OAUTH_TOKEN_REF (not shown) — stderr: $(redact_ref "$ref" < "$tok_err" | tr '\n' ' ' | cut -c1-400)"
    fi
    unset tok
    rm -f "$tok_err"
  else
    fail "AUTH_MODE=enterprise but OAUTH_TOKEN_REF is unset in fleet.conf (op://<vault>/<item>/credential of the \`claude setup-token\` token)"
  fi
  [ -n "$helper" ] && warn "an apiKeyHelper is still in $CONFIG_DIR/settings.json. claude-api empties it for a worker through the --settings it injects, but a worker given its own --settings runs it and bills the API key unless that --settings carries \"apiKeyHelper\": \"\". Remove it once every seat has restarted on the token."
elif [ -n "$helper" ]; then
  ok "apiKeyHelper set in $CONFIG_DIR/settings.json (workers fetch the key at runtime through it)"
  helper_err="$(mktemp)"
  if key="$(eval "$helper" 2>"$helper_err")" && [ -n "$key" ]; then
    case "$key" in
      sk-ant-*) ok "apiKeyHelper produced a key (not shown)" ;;
      *) warn "apiKeyHelper produced output that does not look like an Anthropic key (no sk-ant- prefix; not shown)" ;;
    esac
  else
    fail "apiKeyHelper produced no key — its stderr: $(tr '\n' ' ' < "$helper_err" | cut -c1-400) — for an op read, check OP_SERVICE_ACCOUNT_TOKEN / the op bootstrap file ~/.config/op/service-account-token (with-op exits 2 or 3 with the reason)"
  fi
  unset key
  rm -f "$helper_err"
else
  fail "no apiKeyHelper in $CONFIG_DIR/settings.json — workers fetch the key at runtime through it (an op read under with-op); never a key file"
fi

if [ -d "$CONFIG_DIR" ]; then
  dperms="$(stat -c %a "$CONFIG_DIR" 2>/dev/null || stat -f %Lp "$CONFIG_DIR" 2>/dev/null)"
  [ "$dperms" = "700" ] && ok "config dir $CONFIG_DIR (0700)" || warn "config dir perms are $dperms (expected 700)"
else
  fail "config dir $CONFIG_DIR missing — run setup-worker"
fi

if [ -f "$CONFIG_DIR/settings.json" ]; then
  if python3 -c "import json;json.load(open('$CONFIG_DIR/settings.json'))" 2>/dev/null; then
    ok "worker settings.json parses"
  else
    fail "worker settings.json is invalid JSON"
  fi
else
  warn "worker settings.json missing — run setup-worker"
fi

if [ -f "$CONFIG_DIR/.credentials.json" ]; then
  warn "OAuth credentials present in the worker identity ($CONFIG_DIR/.credentials.json) — if the apiKeyHelper ever fails, workers could silently bill that account. Remove: rm '$CONFIG_DIR/.credentials.json'"
else
  ok "no OAuth credentials in the worker identity"
fi

if [ -L "$CONFIG_DIR/sessions" ] && [ "$(readlink "$CONFIG_DIR/sessions")" = "$HOME/.claude/sessions" ]; then
  ok "session registry shared — workers appear in ListAgents by slug"
else
  warn "session registry not shared — native worker discovery disabled (rerun setup-worker)"
fi

# Both settings files matter: a session reads only the one in its own config dir,
# and a session whose config dir lacks the hook can no longer spawn workers at all
# (claude-api refuses rather than dropping to the acceptEdits floor).
for s in "$HOME/.claude/settings.json" "$CONFIG_DIR/settings.json"; do
  if grep -qs "permission-mode-hook" "$s"; then
    ok "permission-mode hook registered in $s"
  else
    warn "permission-mode hook NOT registered in $s — sessions using that config dir cannot spawn workers (rerun setup-worker, then restart them)"
  fi
done
if [ -x "$HOME/.claude/skills/delegate/../../bin/permission-mode-hook" ]; then
  ok "hook path resolves through the skill symlink"
else
  warn "hook path does not resolve — is ~/.claude/skills/delegate a copy instead of a symlink?"
fi

if [ -f "$HOME/.claude/skills/delegate/SKILL.md" ]; then
  ok "delegate skill installed"
else
  fail "delegate skill missing — run setup-worker"
fi
if [ -x "$HOME/.local/bin/claude-api" ]; then
  ok "claude-api linked in ~/.local/bin"
else
  warn "claude-api not linked in ~/.local/bin — run setup-worker"
fi
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ok "~/.local/bin on PATH" ;;
  *) warn "~/.local/bin NOT on PATH — the skill's fallback path still works" ;;
esac

if [ "${1:-}" = "--ping" ]; then
  echo "  ....  live ping (one sonnet worker run)"
  out="$("$BIN_DIR/claude-api" -p 'Reply with exactly: PING OK' --model sonnet --output-format json 2>/tmp/claude-api-doctor-ping.err)" \
    && printf '%s' "$out" | grep -q "PING OK" \
    && ok "live worker run OK (bills the API key)" \
    || { fail "live ping failed — see /tmp/claude-api-doctor-ping.err"; }
fi

echo
echo "doctor: $fails fail, $warns warn"
[ "$fails" -eq 0 ]
