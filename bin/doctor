#!/usr/bin/env bash
# Install health check (dispatched as: claude-api doctor [--ping]).
# Verifies every load-bearing assumption without printing the key.
# --ping additionally does one live worker run (spends a little API credit).
set -uo pipefail

SRC="${BASH_SOURCE[0]}"
while [ -L "$SRC" ]; do
  dir="$(cd "$(dirname "$SRC")" && pwd)"
  SRC="$(readlink "$SRC")"
  case "$SRC" in /*) ;; *) SRC="$dir/$SRC" ;; esac
done
BIN_DIR="$(cd "$(dirname "$SRC")" && pwd)"
CONFIG_DIR="${CLAUDE_API_CONFIG_DIR:-$HOME/.claude-api}"

fails=0; warns=0
ok()   { echo "  ok    $1"; }
warn() { echo "  WARN  $1"; warns=$((warns + 1)); }
fail() { echo "  FAIL  $1"; fails=$((fails + 1)); }

echo "claude-api doctor"

if command -v claude >/dev/null 2>&1; then
  ok "claude on PATH ($(claude --version 2>/dev/null | head -1))"
else
  fail "claude not on PATH — npm install -g @anthropic-ai/claude-code"
fi

# API key source: the apiKeyHelper in the config dir's settings.json — Claude
# Code runs it in the worker process to fetch the key at runtime (an `op read`
# from 1Password under with-op). No key file, no Keychain (security reset
# 2026-09-06). Probe it once here so an op failure shows its reason; the key
# itself is never printed.
helper="$(python3 - "$CONFIG_DIR/settings.json" <<'PY' 2>/dev/null
import json, sys
try:
    v = json.load(open(sys.argv[1])).get("apiKeyHelper")
except Exception:
    v = None
print(v.strip() if isinstance(v, str) else "")
PY
)"
if [ -n "$helper" ]; then
  ok "apiKeyHelper set in $CONFIG_DIR/settings.json (workers fetch the key at runtime through it)"
  helper_err="$(mktemp)"
  if key="$(eval "$helper" 2>"$helper_err")" && [ -n "$key" ]; then
    case "$key" in
      sk-ant-*) ok "apiKeyHelper produced a key (not shown)" ;;
      *) warn "apiKeyHelper produced output that does not look like an Anthropic key (no sk-ant- prefix; not shown)" ;;
    esac
  else
    fail "apiKeyHelper produced no key — its stderr: $(tr '\n' ' ' < "$helper_err" | cut -c1-400) — for an op read, check OP_SERVICE_ACCOUNT_TOKEN / the op bootstrap file ~/.config/op/service-account-token (with-op exits 2 or 3 with the reason)"
  fi
  unset key
  rm -f "$helper_err"
else
  fail "no apiKeyHelper in $CONFIG_DIR/settings.json — workers fetch the key at runtime through it (an op read under with-op); never a key file"
fi

if [ -d "$CONFIG_DIR" ]; then
  dperms="$(stat -c %a "$CONFIG_DIR" 2>/dev/null || stat -f %Lp "$CONFIG_DIR" 2>/dev/null)"
  [ "$dperms" = "700" ] && ok "config dir $CONFIG_DIR (0700)" || warn "config dir perms are $dperms (expected 700)"
else
  fail "config dir $CONFIG_DIR missing — run setup-worker"
fi

if [ -f "$CONFIG_DIR/settings.json" ]; then
  if python3 -c "import json;json.load(open('$CONFIG_DIR/settings.json'))" 2>/dev/null; then
    ok "worker settings.json parses"
  else
    fail "worker settings.json is invalid JSON"
  fi
else
  warn "worker settings.json missing — run setup-worker"
fi

if [ -f "$CONFIG_DIR/.credentials.json" ]; then
  warn "OAuth credentials present in the worker identity ($CONFIG_DIR/.credentials.json) — if the apiKeyHelper ever fails, workers could silently bill that account. Remove: rm '$CONFIG_DIR/.credentials.json'"
else
  ok "no OAuth credentials in the worker identity"
fi

if [ -L "$CONFIG_DIR/sessions" ] && [ "$(readlink "$CONFIG_DIR/sessions")" = "$HOME/.claude/sessions" ]; then
  ok "session registry shared — workers appear in ListAgents by slug"
else
  warn "session registry not shared — native worker discovery disabled (rerun setup-worker)"
fi

# Both settings files matter: a session reads only the one in its own config dir,
# and a session whose config dir lacks the hook can no longer spawn workers at all
# (claude-api refuses rather than dropping to the acceptEdits floor).
for s in "$HOME/.claude/settings.json" "$CONFIG_DIR/settings.json"; do
  if grep -qs "permission-mode-hook" "$s"; then
    ok "permission-mode hook registered in $s"
  else
    warn "permission-mode hook NOT registered in $s — sessions using that config dir cannot spawn workers (rerun setup-worker, then restart them)"
  fi
done
if [ -x "$HOME/.claude/skills/delegate/../../bin/permission-mode-hook" ]; then
  ok "hook path resolves through the skill symlink"
else
  warn "hook path does not resolve — is ~/.claude/skills/delegate a copy instead of a symlink?"
fi

if [ -f "$HOME/.claude/skills/delegate/SKILL.md" ]; then
  ok "delegate skill installed"
else
  fail "delegate skill missing — run setup-worker"
fi
if [ -x "$HOME/.local/bin/claude-api" ]; then
  ok "claude-api linked in ~/.local/bin"
else
  warn "claude-api not linked in ~/.local/bin — run setup-worker"
fi
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ok "~/.local/bin on PATH" ;;
  *) warn "~/.local/bin NOT on PATH — the skill's fallback path still works" ;;
esac

if [ "${1:-}" = "--ping" ]; then
  echo "  ....  live ping (one sonnet worker run)"
  out="$("$BIN_DIR/claude-api" -p 'Reply with exactly: PING OK' --model sonnet --output-format json 2>/tmp/claude-api-doctor-ping.err)" \
    && printf '%s' "$out" | grep -q "PING OK" \
    && ok "live worker run OK (bills the API key)" \
    || { fail "live ping failed — see /tmp/claude-api-doctor-ping.err"; }
fi

echo
echo "doctor: $fails fail, $warns warn"
[ "$fails" -eq 0 ]
